<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_farm_credit_score" model="ir.sequence">
            <field name="name">Farm Credit Score</field>
            <field name="code">farm.credit.score</field>
            <field name="prefix">CS/%(year)s/</field>
            <field name="padding">5</field>
        </record>

        <record id="seq_farm_coop_settlement" model="ir.sequence">
            <field name="name">Coop Settlement</field>
            <field name="code">farm.coop.settlement</field>
            <field name="prefix">SETL/%(year)s/</field>
            <field name="padding">5</field>
        </record>
    </data>
</odoo>
