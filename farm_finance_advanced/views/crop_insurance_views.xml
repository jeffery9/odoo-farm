<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Crop Yield Insurance Views -->
    <record id="view_farm_crop_yield_insurance_form" model="ir.ui.view">
        <field name="name">farm.crop.yield.insurance.form</field>
        <field name="model">farm.crop.yield.insurance</field>
        <field name="arch" type="xml">
            <form string="Crop Yield Insurance">
                <header>
                    <button name="action_submit_application" type="object" string="Submit Application" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_approve_insurance" type="object" string="Approve" invisible="state != 'submitted'"/>
                    <button name="action_activate_insurance" type="object" string="Activate" invisible="state != 'approved'"/>
                    <button name="calculate_expected_yield" type="object" string="Calculate Yield" class="oe_highlight"/>
                    <button name="action_check_weather_indices" type="object" string="Check Weather Triggers" class="oe_highlight" invisible="state != 'active'"/>
                    <button name="calculate_claim" type="object" string="Manual Claim Trigger" invisible="state != 'active'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,active,claim_made,settled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="product_id"/>
                            <field name="land_location_id"/>
                        </group>
                        <group>
                            <field name="reference"/>
                            <field name="risk_score"/>
                            <field name="application_date"/>
                        </group>
                    </group>
                    <group string="Coverage Details">
                        <group>
                            <field name="coverage_area"/>
                            <field name="coverage_percentage"/>
                            <field name="coverage_type"/>
                        </group>
                        <group>
                            <field name="expected_yield"/>
                            <field name="historical_yield"/>
                        </group>
                    </group>
                    <group string="Financial Details">
                        <group>
                            <field name="amount"/>
                            <field name="premium_rate"/>
                            <field name="premium_amount"/>
                        </group>
                        <group>
                            <field name="indemnity_base_price"/>
                            <field name="currency_id"/>
                            <field name="service_fees"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Claims &amp; Triggers" name="claims">
                            <group string="Automated Weather Indices">
                                <field name="weather_index_ids" widget="many2many_tags"/>
                            </group>
                            <field name="claim_ids" readonly="1">
                                <list decoration-info="state == 'draft'" decoration-success="state == 'approved'">
                                    <field name="claim_type"/>
                                    <field name="requested_amount"/>
                                    <field name="state" widget="badge"/>
                                    <field name="auto_triggered"/>
                                </list>
                            </field>
                        </page>
                        <page string="History &amp; Monitoring">
                            <group>
                                <field name="planting_date"/>
                                <field name="duration_months"/>
                                <field name="maturity_date"/>
                                <field name="weather_monitoring"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_farm_crop_yield_insurance_tree" model="ir.ui.view">
        <field name="name">farm.crop.yield.insurance.tree</field>
        <field name="model">farm.crop.yield.insurance</field>
        <field name="arch" type="xml">
            <list string="Crop Yield Insurance">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="coverage_area"/>
                <field name="amount"/>
                <field name="claim_status"/>
                <field name="state" widget="badge"/>
            </list>
        </arch>
    </record>

    <record id="action_farm_crop_yield_insurance" model="ir.actions.act_window">
        <field name="name">Crop Yield Insurance</field>
        <field name="res_model">farm.crop.yield.insurance</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Insurance Index Views -->
    <record id="view_farm_insurance_index_tree" model="ir.ui.view">
        <field name="name">farm.insurance.index.list</field>
        <field name="model">farm.insurance.index</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="index_type"/>
                <field name="threshold_value"/>
                <field name="comparison_operator"/>
                <field name="payout_factor"/>
            </list>
        </arch>
    </record>

    <record id="action_farm_insurance_index" model="ir.actions.act_window">
        <field name="name">Insurance Indices</field>
        <field name="res_model">farm.insurance.index</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu items in Finance -->
    <menuitem id="menu_farm_finance_insurance" name="Agri-Insurance" 
              parent="farm_financial.menu_finance_root" sequence="30"/>
    <menuitem id="menu_farm_crop_yield_insurance" name="Crop Yield Insurance" 
              parent="menu_farm_finance_insurance" action="action_farm_crop_yield_insurance" sequence="10"/>
    <menuitem id="menu_farm_insurance_index" name="Trigger Indices" 
              parent="menu_farm_finance_insurance" action="action_farm_insurance_index" sequence="20"/>
</odoo>
