<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Carbon Credit Finance Views -->
    <record id="view_carbon_credit_finance_form" model="ir.ui.view">
        <field name="name">carbon.credit.finance.form</field>
        <field name="model">carbon.credit.finance</field>
        <field name="arch" type="xml">
            <form string="Carbon Credit Finance">
                <header>
                    <button name="action_submit_application" type="object" string="Submit Application" class="oe_highlight" invisible="status != 'draft'"/>
                    <button name="action_approve_application" type="object" string="Approve" invisible="status != 'pending'"/>
                    <button name="action_reject_application" type="object" string="Reject" invisible="status != 'pending'"/>
                    <button name="action_activate_service" type="object" string="Activate" invisible="status != 'approved'"/>
                    <button name="calculate_emission_reduction" type="object" string="Calculate Reduction" class="oe_highlight"/>
                    <button name="verify_project" type="object" string="Verify Project" class="oe_highlight" invisible="implementation_status != 'completed'"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,pending,approved,rejected,active,completed,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_complete_service" type="object" string="Complete" class="oe_stat_button" icon="fa-check-circle" invisible="status != 'active'"/>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="credit_type"/>
                            <field name="financing_structure"/>
                        </group>
                        <group>
                            <field name="partner_id"/>
                            <field name="status"/>
                            <field name="reference"/>
                        </group>
                    </group>
                    <group string="Project Details">
                        <group>
                            <field name="project_area"/>
                            <field name="project_location"/>
                            <field name="project_start_date"/>
                        </group>
                        <group>
                            <field name="credit_validity_years"/>
                            <field name="implementation_status"/>
                        </group>
                    </group>
                    <group string="Financial Details">
                        <group>
                            <field name="baseline_emissions"/>
                            <field name="projected_reduction"/>
                        </group>
                        <group>
                            <field name="credit_quantity"/>
                            <field name="credit_value_per_ton"/>
                        </group>
                    </group>
                    <group string="Monetary Values">
                        <group>
                            <field name="amount"/>
                            <field name="total_credit_value"/>
                            <field name="currency_id"/>
                        </group>
                        <group>
                            <field name="interest_rate"/>
                            <field name="duration_months"/>
                        </group>
                    </group>
                    <group>
                        <field name="methodology_id"/>
                        <field name="registry_name"/>
                        <field name="certification_body"/>
                    </group>
                    <group>
                        <field name="verification_date"/>
                        <field name="risk_score"/>
                    </group>
                    <notebook>
                        <page string="Risk Assessment">
                            <group>
                                <field name="risk_score"/>
                                <field name="service_fees"/>
                                <field name="application_date"/>
                                <field name="approval_date"/>
                            </group>
                        </page>
                        <page string="Certification">
                            <group>
                                <field name="methodology_id"/>
                                <field name="registry_name"/>
                                <field name="certification_body"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_carbon_credit_finance_tree" model="ir.ui.view">
        <field name="name">carbon.credit.finance.tree</field>
        <field name="model">carbon.credit.finance</field>
        <field name="arch" type="xml">
            <tree string="Carbon Credit Finance">
                <field name="name"/>
                <field name="credit_type"/>
                <field name="project_area"/>
                <field name="total_credit_value"/>
                <field name="implementation_status"/>
                <field name="status"/>
            </tree>
        </field>
    </record>

    <record id="action_carbon_credit_finance" model="ir.actions.act_window">
        <field name="name">Carbon Credit Finance</field>
        <field name="res_model">carbon.credit.finance</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>