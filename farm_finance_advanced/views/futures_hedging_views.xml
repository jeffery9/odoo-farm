<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Futures Hedging Views -->
    <record id="view_futures_hedging_form" model="ir.ui.view">
        <field name="name">futures.hedging.form</field>
        <field name="model">futures.hedging</field>
        <field name="arch" type="xml">
            <form string="Agricultural Futures Hedging">
                <header>
                    <button name="update_current_price" type="object" string="Update Price" class="oe_highlight"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,pending,approved,rejected,active,completed,cancelled"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="commodity_type"/>
                        </group>
                        <group>
                            <field name="status"/>
                            <field name="reference"/>
                        </group>
                    </group>
                    <group string="Contract Details">
                        <group>
                            <field name="contract_month"/>
                            <field name="contract_year"/>
                            <field name="contract_size"/>
                        </group>
                        <group>
                            <field name="number_of_contracts"/>
                            <field name="position_type"/>
                            <field name="strategy_type"/>
                        </group>
                    </group>
                    <group string="Price Information">
                        <group>
                            <field name="entry_price"/>
                            <field name="current_price"/>
                            <field name="exit_price"/>
                        </group>
                        <group>
                            <field name="stop_loss_price"/>
                            <field name="take_profit_price"/>
                        </group>
                    </group>
                    <group string="Financials">
                        <group>
                            <field name="amount"/>
                            <field name="margin_amount"/>
                            <field name="unrealized_pnl"/>
                        </group>
                        <group>
                            <field name="currency_id"/>
                            <field name="hedge_effectiveness"/>
                        </group>
                    </group>
                    <group>
                        <field name="exchange_name"/>
                        <field name="broker_id"/>
                        <field name="position_status"/>
                        <field name="risk_score"/>
                    </group>
                    <notebook>
                        <page string="Contract Specifications">
                            <group>
                                <field name="commodity_type"/>
                                <field name="contract_month"/>
                                <field name="contract_year"/>
                                <field name="exchange_name"/>
                            </group>
                        </page>
                        <page string="Risk Management">
                            <group>
                                <field name="stop_loss_price"/>
                                <field name="take_profit_price"/>
                                <field name="margin_amount"/>
                                <field name="unrealized_pnl"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_futures_hedging_tree" model="ir.ui.view">
        <field name="name">futures.hedging.tree</field>
        <field name="model">futures.hedging</field>
        <field name="arch" type="xml">
            <tree string="Agricultural Futures Hedging">
                <field name="name"/>
                <field name="commodity_type"/>
                <field name="position_type"/>
                <field name="entry_price"/>
                <field name="current_price"/>
                <field name="unrealized_pnl"/>
                <field name="position_status"/>
            </tree>
        </field>
    </record>

    <record id="action_futures_hedging" model="ir.actions.act_window">
        <field name="name">Futures Hedging</field>
        <field name="res_model">futures.hedging</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>