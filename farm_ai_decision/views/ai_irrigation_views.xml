<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>
<record id="view_ai_irrigation_decision_form" model="ir.ui.view">
        <field name="name">agri.ai.irrigation.decision.form</field>
        <field name="model">agri.ai.irrigation.decision</field>
        <field name="arch" type="xml">
            <form string="AI Irrigation Decision">
                <header>
                    <button name="action_fetch_iot_shadow" type="object" string="Fetch IoT Shadow" class="btn-secondary" />
                    <button name="calculate_irrigation_needs" type="object" string="Calculate Needs" class="oe_highlight" />
                    <field name="status" widget="statusbar" statusbar_visible="draft,recommended,applied,completed,rejected" />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <field name="result_intervention_id" invisible="1" />
                        <button name="action_apply_recommendation" type="object" string="Apply Recommendation" class="oe_stat_button" icon="fa-play" invisible="status != 'recommended'" />
                        <button name="action_reject_recommendation" type="object" string="Reject" class="oe_stat_button" icon="fa-times" invisible="status != 'recommended'" />
                        <button name="action_mark_completed" type="object" string="Mark Completed" class="oe_stat_button" icon="fa-check-circle" invisible="status != 'applied'" />
                    </div>
                    <group>
                        <group>
                            <field name="land_location_id" />
                            <field name="product_id" />
                            <field name="result_intervention_id" invisible="not result_intervention_id" />
                        </group>
                        <group>
                            <field name="confidence_score" />
                            <field name="priority" />
                            <field name="status" />
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="current_soil_moisture" />
                            <field name="recommended_water_amount" />
                        </group>
                        <group>
                            <field name="recommended_irrigation_time" />
                            <field name="irrigation_efficiency" />
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="irrigation_system" />
                            <field name="irrigation_method" />
                        </group>
                        <group>
                            <field name="evapotranspiration_rate" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Weather Data">
                            <field name="weather_forecast" placeholder="Weather forecast data" />
                        </page>
                        <page string="Irrigation Advice">
                            <field name="irrigation_advice" placeholder="Irrigation recommendations" />
                        </page>
                        <page string="Soil Analysis">
                            <field name="soil_analysis" placeholder="Soil analysis data" />
                        </page>
                        <page string="Results">
                            <group>
                                <field name="recommendation" placeholder="Overall recommendation" />
                                <field name="decision_reasoning" placeholder="Reasoning behind the AI decision" />
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ai_irrigation_decision_tree" model="ir.ui.view">
        <field name="name">agri.ai.irrigation.decision.tree</field>
        <field name="model">agri.ai.irrigation.decision</field>
        <field name="arch" type="xml">
            <list string="AI Irrigation Decisions">
                <field name="land_location_id" />
                <field name="product_id" />
                <field name="current_soil_moisture" />
                <field name="recommended_water_amount" />
                <field name="confidence_score" />
                <field name="status" />
            </list>
        </field>
    </record>

    <record id="action_ai_irrigation_decision" model="ir.actions.act_window">
        <field name="name">AI Irrigation Decisions</field>
        <field name="res_model">agri.ai.irrigation.decision</field>
        <field name="view_mode">list,form</field>
    </record>
</data>
</odoo>