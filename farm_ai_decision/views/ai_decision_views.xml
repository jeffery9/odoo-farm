<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ai_decision_engine_list" model="ir.ui.view">
        <field name="name">ai.decision.engine.list</field>
        <field name="model">ai.decision.engine</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="intervention_id"/>
                <field name="stress_index" widget="progressbar"/>
                <field name="growth_stage_id"/>
                <field name="predicted_harvest_date"/>
                <field name="confidence_score"/>
            </list>
        </field>
    </record>

    <record id="view_ai_decision_engine_form" model="ir.ui.view">
        <field name="name">ai.decision.engine.form</field>
        <field name="model">ai.decision.engine</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_generate_recovery_plan" string="Generate AI Recovery" type="object" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Source Audit">
                            <field name="intervention_id"/>
                            <field name="growth_stage_id"/>
                            <field name="stress_index" widget="progressbar"/>
                        </group>
                        <group string="Harvest Prediction">
                            <field name="predicted_harvest_date"/>
                            <field name="confidence_score"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="AI Suggestion" name="suggestion">
                            <group>
                                <field name="recovery_plan" readonly="1"/>
                                <field name="active_skill_json" widget="ace" options="{'mode': 'json'}"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_ai_decision_engine" model="ir.actions.act_window">
        <field name="name">AI Decision Hub</field>
        <field name="res_model">ai.decision.engine</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_ai_decision_hub" name="AI Decision Hub" parent="farm_ai.menu_ai_root" action="action_ai_decision_engine" sequence="10"/>
</odoo>
