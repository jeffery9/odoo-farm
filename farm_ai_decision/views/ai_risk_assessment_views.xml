<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>
<record id="view_ai_risk_assessment_form" model="ir.ui.view">
        <field name="name">agri.ai.risk.assessment.form</field>
        <field name="model">agri.ai.risk.assessment</field>
        <field name="arch" type="xml">
            <form string="AI Risk Assessment">
                <header>
                    <button name="perform_risk_assessment" type="object" string="Assess Risk" class="oe_highlight" />
                    <field name="status" widget="statusbar" statusbar_visible="draft,recommended,applied,completed,rejected" />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_apply_recommendation" type="object" string="Apply Strategy" class="oe_stat_button" icon="fa-check" invisible="status != 'recommended'" />
                        <button name="action_reject_recommendation" type="object" string="Reject" class="oe_stat_button" icon="fa-times" invisible="status != 'recommended'" />
                        <button name="action_mark_completed" type="object" string="Mark Completed" class="oe_stat_button" icon="fa-check-circle" invisible="status != 'applied'" />
                    </div>
                    <group>
                        <group>
                            <field name="risk_category" />
                            <field name="risk_location_id" />
                        </group>
                        <group>
                            <field name="risk_probability" />
                            <field name="risk_impact" />
                        </group>
                    </group>
                    <group>
                        <field name="risk_score" />
                        <field name="risk_level" />
                        <field name="confidence_score" />
                        <field name="status" />
                    </group>
                    <group>
                        <field name="monitoring_frequency" />
                    </group>
                    <notebook>
                        <page string="Risk Factors">
                            <field name="risk_factors" placeholder="Risk factors JSON data" />
                        </page>
                        <page string="Mitigation Strategies">
                            <field name="mitigation_strategies" placeholder="Risk mitigation strategies" />
                        </page>
                        <page string="Contingency Plans">
                            <field name="contingency_plans" placeholder="Contingency plans" />
                        </page>
                        <page string="Results">
                            <group>
                                <field name="recommendation" placeholder="Overall recommendation" />
                                <field name="decision_reasoning" placeholder="Reasoning behind the AI decision" />
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ai_risk_assessment_tree" model="ir.ui.view">
        <field name="name">agri.ai.risk.assessment.tree</field>
        <field name="model">agri.ai.risk.assessment</field>
        <field name="arch" type="xml">
            <list string="AI Risk Assessment">
                <field name="risk_category" />
                <field name="risk_score" />
                <field name="risk_level" />
                <field name="risk_probability" />
                <field name="confidence_score" />
                <field name="status" />
            </list>
        </field>
    </record>

    <record id="action_ai_risk_assessment" model="ir.actions.act_window">
        <field name="name">AI Risk Assessment</field>
        <field name="res_model">agri.ai.risk.assessment</field>
        <field name="view_mode">list,form</field>
    </record>
</data>
</odoo>