<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_agri_intervention_form_ai_cockpit_inherit" model="ir.ui.view">
        <field name="name">mrp.production.form.ai.cockpit.inherit</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="farm_operation.view_agri_intervention_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <!-- 科学压力预警 (红色条) -->
                <div class="alert alert-danger mb-0 text-center" role="alert" 
                     invisible="not has_critical_stress"
                     style="font-weight: bold; font-size: 1.1em;">
                    <i class="fa fa-warning mr-2"/> 
                    [CRITICAL STRESS] Biological stress level is at <field name="biological_stress_index" readonly="1"/>%. 
                </div>
                <!-- AI 决策推荐 (信息条) -->
                <div class="alert alert-info mb-0 text-center" role="alert" 
                     invisible="ai_recommendation_count == 0">
                    <i class="fa fa-lightbulb-o mr-2"/> 
                    AI suggested <field name="ai_recommendation_count" readonly="1"/> recovery actions. 
                    <button name="action_approve_latest_ai_skill" string="Apply Best" type="object" class="btn-link p-0 align-baseline" style="font-weight: bold;"/> 
                    or <button name="action_view_ai_cockpit" string="View Cockpit" type="object" class="btn-link p-0 align-baseline" style="font-weight: bold;"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
