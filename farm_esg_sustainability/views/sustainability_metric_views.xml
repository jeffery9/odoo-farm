<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record id="view_sustainability_metric_tree" model="ir.ui.view">
        <field name="name">farm.sustainability.metric.tree</field>
        <field name="model">farm.sustainability.metric</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="category"/>
                <field name="current_value"/>
                <field name="target_value"/>
                <field name="progress_rate"/>
                <field name="is_active"/>
            </list>
        </field>
    </record>

    
    <record id="view_sustainability_metric_form" model="ir.ui.view">
        <field name="name">farm.sustainability.metric.form</field>
        <field name="model">farm.sustainability.metric</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_update_value" type="object" string="更新指标值" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_update_value" type="object" string="更新指标值" class="oe_stat_button" icon="fa-pencil"/>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="category"/>
                            <field name="unit"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="is_active"/>
                            <field name="calculation_method"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                    <group string="目标与当前值">
                        <group>
                            <field name="target_value"/>
                            <field name="current_value"/>
                            <field name="progress_rate"/>
                            <field name="last_updated"/>
                        </group>
                    </group>
                    <group string="计算公式" invisible="calculation_method != 'formula'">
                        <field name="formula" nolabel="1"/>
                    </group>
                    <notebook>
                        <page string="指标值历史">
                            <field name="value_history_ids">
                                <list>
                                    <field name="date"/>
                                    <field name="value"/>
                                    <field name="note"/>
                                    <field name="recorded_by"/>
                                </list>
                                <form>
                                    <group>
                                        <field name="date"/>
                                        <field name="value"/>
                                        <field name="note"/>
                                        <field name="recorded_by"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    
    <record id="action_sustainability_metric" model="ir.actions.act_window">
        <field name="name">可持续性指标</field>
        <field name="res_model">farm.sustainability.metric</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>