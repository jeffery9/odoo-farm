<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>
<record id="agricultural_campaign_view_graph_sustainability" model="ir.ui.view">
        <field name="name">farm.agricultural.campaign.graph.sustainability</field>
        <field name="model">farm.agricultural.campaign</field>
        <field name="arch" type="xml">
            <graph string="Nutrient Reduction Trends" type="bar">
                <field name="name" type="row" />
                <field name="total_n" type="measure" />
                <field name="total_p" type="measure" />
                <field name="total_k" type="measure" />
            </graph>
        </field>
    </record>

    <record id="action_farm_sustainability_dashboard" model="ir.actions.act_window">
        <field name="name">Sustainability Dashboard</field>
        <field name="res_model">farm.agricultural.campaign</field>
        <field name="view_mode">list,graph,pivot</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Compare nutrient usage across seasons to track your ecological footprint.
            </p>
        </field>
    </record>

    

    
    <record id="agri_ecological_activity_view_tree" model="ir.ui.view">
        <field name="name">agri.ecological.activity.list</field>
        <field name="model">agri.ecological.activity</field>
        <field name="arch" type="xml">
            <list string="Ecological Activities">
                <field name="date" />
                <field name="name" />
                <field name="location_id" />
                <field name="impact_category" />
            </list>
        </field>
    </record>

    <record id="agri_ecological_activity_view_form" model="ir.ui.view">
        <field name="name">agri.ecological.activity.form</field>
        <field name="model">agri.ecological.activity</field>
        <field name="arch" type="xml">
            <form string="Ecological Activity">
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="date" />
                        <field name="location_id" />
                        <field name="impact_category" />
                        <field name="description" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_agri_ecological_activity" model="ir.actions.act_window">
        <field name="name">Ecological Maintenance</field>
        <field name="res_model">agri.ecological.activity</field>
        <field name="view_mode">list,form</field>
    </record>

    
    <record id="farm_ecological_activity_view_tree" model="ir.ui.view">
        <field name="name">farm.ecological.activity.list</field>
        <field name="model">agri.ecological.activity</field>
        <field name="arch" type="xml">
            <list string="Ecological Activities">
                <field name="date" />
                <field name="name" />
                <field name="location_id" />
                <field name="impact_category" />
            </list>
        </field>
    </record>

    <record id="action_farm_ecological_activity" model="ir.actions.act_window">
        <field name="name">Ecological Maintenance</field>
        <field name="res_model">agri.ecological.activity</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_sustainability_root" name="Sustainability" sequence="90" groups="farm_core.group_farm_manager" />
    <menuitem id="menu_sustainability_dashboard" name="Impact Dashboard" parent="menu_sustainability_root" action="action_farm_sustainability_dashboard" sequence="10" />
    <menuitem id="menu_ecological_activity" name="Ecological Records" parent="menu_sustainability_root" action="action_agri_ecological_activity" sequence="20" />
    
    <menuitem id="menu_ecological_activity_legacy" name="Ecological Records (Legacy)" parent="menu_sustainability_root" action="action_farm_ecological_activity" sequence="21" />
</data>
</odoo>