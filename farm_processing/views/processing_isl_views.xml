<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_farm_processing_bom_form" model="ir.ui.view">
        <field name="name">farm.processing.bom.form</field>
        <field name="model">farm.processing.bom</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="bom_id"/>
                        <field name="processing_type"/>
                    </group>
                    <notebook>
                        <page string="Components" name="components">
                            <field name="bom_line_ids">
                                <list>
                                    <field name="product_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_farm_processing_production_form" model="ir.ui.view">
        <field name="name">farm.processing.production.form</field>
        <field name="model">farm.processing.production</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="mrp_production_id"/>
                        <field name="processing_type"/>
                    </group>
                    <notebook>
                        <page string="Agri Processing" name="agri_processing">
                            <group name="industry_params" string="Industry Parameters">
                            </group>
                            <group name="mass_energy" string="Mass Balance &amp; Energy">
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
