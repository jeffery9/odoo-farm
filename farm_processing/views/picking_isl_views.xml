<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>
<record id="view_farm_industry_picking_form" model="ir.ui.view">
        <field name="name">farm.industry.picking.form</field>
        <field name="model">farm.industry.picking</field>
        <field name="arch" type="xml">
            <form string="Picking ISL">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="picking_id" placeholder="Picking" /></h1>
                    </div>
                    <group>
                        <field name="industry_type" />
                        <field name="cold_chain_status" />
                        <field name="logistics_agent_id" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</data>
</odoo>