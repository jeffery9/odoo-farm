<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_farm_package_form" model="ir.ui.view">
        <field name="name">farm.package.form</field>
        <field name="model">farm.package</field>
        <field name="arch" type="xml">
            <form string="Package">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Package Name"/></h1>
                    </div>
                    <group>
                        <field name="package_level_id"/>
                        <field name="capacity"/>
                        <field name="reusable"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
