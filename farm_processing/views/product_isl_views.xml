<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_farm_agri_product_form" model="ir.ui.view">
        <field name="name">farm.agri.product.form</field>
        <field name="model">farm.agri.product</field>
        <field name="arch" type="xml">
            <form string="Product ISL">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="product_tmpl_id" placeholder="Product"/></h1>
                    </div>
                    <group>
                        <field name="agri_product_type"/>
                        <field name="shelf_life_days"/>
                        <field name="storage_temperature"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
