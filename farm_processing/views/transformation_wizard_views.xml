<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_farm_transformation_wizard_form" model="ir.ui.view">
        <field name="name">farm.transformation.wizard.form</field>
        <field name="model">farm.transformation.wizard</field>
        <field name="arch" type="xml">
            <form string="Product Transformation / Downgrade">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        Use this wizard to record the immediate transformation of sub-standard lots into secondary products (e.g., Damaged Apples -> Apple Juice Base).
                    </div>
                    <group>
                        <group string="Source Batch">
                            <field name="source_lot_id"/>
                            <field name="source_qty"/>
                        </group>
                        <group string="Target Product">
                            <field name="target_product_id"/>
                            <field name="target_qty_expected"/>
                        </group>
                    </group>
                    <group>
                        <field name="transformation_reason"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm_transformation" type="object" string="Confirm Transformation" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_farm_transformation_wizard" model="ir.actions.act_window">
        <field name="name">Batch Transformation</field>
        <field name="res_model">farm.transformation.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    
    <menuitem id="menu_farm_transformation_wizard" name="Batch Transformation" parent="menu_farm_processing_settings" action="action_farm_transformation_wizard" sequence="50"/>
</odoo>
