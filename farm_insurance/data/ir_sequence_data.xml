<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record id="seq_farm_crop_yield_insurance_policy" model="ir.sequence">
        <name>Crop Yield Insurance Policy</name>
        <field name="code">POLICY</field>
        <field name="prefix">POL/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_farm_insurance_claim" model="ir.sequence">
        <name>Insurance Claim</name>
        <field name="code">CLAIM</field>
        <field name="prefix">CLM/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>