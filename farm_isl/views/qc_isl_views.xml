<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ISL Quality Control Views -->
    <record id="view_isl_quality_control_form" model="ir.ui.view">
        <field name="name">farm.quality.control.form</field>
        <field name="model">farm.quality.control</field>
        <field name="arch" type="xml">
            <form string="ISL Quality Control">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="control_point_category"/>
                            <field name="picking_type_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="industry_type"/>
                            <field name="quality_standard"/>
                            <field name="is_isl_model"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Industry Specific" invisible="industry_type != 'food_processing'">
                            <group>
                                <field name="ccp_monitoring" placeholder="HACCP Critical Control Point monitoring"/>
                            </group>
                        </page>
                        <page string="Industry Specific" invisible="industry_type != 'pharmaceutical'">
                            <group>
                                <field name="aql_sampling" placeholder="Pharmaceutical AQL sampling procedures"/>
                            </group>
                        </page>
                        <page string="Industry Specific" invisible="industry_type != 'chemical'">
                            <group>
                                <field name="testing_procedures" placeholder="Chemical testing procedures"/>
                            </group>
                        </page>
                        <page string="General Industry Info">
                            <group>
                                <field name="quality_procedures"/>
                                <field name="inspection_frequency"/>
                                <field name="critical_control_points"/>
                                <field name="quality_metrics"/>
                                <field name="acceptance_criteria"/>
                                <field name="deviation_handling"/>
                            </group>
                        </page>
                        <page string="Conditions">
                            <field name="test_type_id" invisible="1"/>
                            <field name="quality_test_id"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_isl_quality_control_tree" model="ir.ui.view">
        <field name="name">farm.quality.control.tree</field>
        <field name="model">farm.quality.control</field>
        <field name="arch" type="xml">
            <tree string="ISL Quality Controls">
                <field name="name"/>
                <field name="control_point_category"/>
                <field name="quality_standard"/>
                <field name="industry_type"/>
            </tree>
        </field>
    </record>

    <record id="action_isl_quality_control" model="ir.actions.act_window">
        <field name="name">ISL Quality Controls</field>
        <field name="res_model">farm.quality.control</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>