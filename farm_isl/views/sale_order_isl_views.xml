<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record id="view_isl_sale_order_form" model="ir.ui.view">
        <field name="name">farm.sale.order.form</field>
        <field name="model">farm.sale.order</field>
        <field name="arch" type="xml">
            <form string="ISL Sale Order">
                <header>
                    
                    
                    <field name="state" widget="statusbar" statusbar_visible="draft,sent,sale,done,cancel"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        
                    </div>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" context="{'res_partner_search_mode': 'customer', 'show_address': 1}" options='{"always_reload": True}'/>
                            <field name="date_order"/>
                            <field name="user_id"/>
                        </group>
                        <group>
                            <field name="industry_type"/>
                            <field name="industry_certification"/>
                            <field name="is_isl_model"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Industry Specific" invisible="industry_type != 'food_processing'">
                            <group>
                                <field name="traceability_requirements" placeholder="Food traceability requirements"/>
                                <field name="temperature_monitoring"/>
                            </group>
                        </page>
                        <page string="Industry Specific" invisible="industry_type != 'pharmaceutical'">
                            <group>
                                <field name="temperature_monitoring"/>
                                <field name="certificate_requirements" placeholder="Pharmaceutical certificate requirements"/>
                            </group>
                        </page>
                        <page string="Industry Specific" invisible="industry_type != 'chemical'">
                            <group>
                                <field name="shipping_conditions" placeholder="Chemical shipping conditions"/>
                            </group>
                        </page>
                        <page string="General Industry Info">
                            <group>
                                <field name="compliance_requirements"/>
                                <field name="quality_assurance"/>
                                <field name="delivery_compliance"/>
                            </group>
                        </page>
                        <page string="Order Lines">
                            <field name="order_line" nolabel="1" context="{'partner_id': partner_id, 'pricelist': pricelist_id, 'company_id': company_id}">
                                <list editable="bottom">
                                    <field name="product_id" options="{'no_create_edit': True}"/>
                                    <field name="name" invisible="context.get('show_line_note', True)"/>
                                    <field name="product_uom_qty"/>
                                    <field name="product_uom_id"/>
                                    <field name="price_unit"/>
                                    
                                    <field name="discount" groups="sale.group_discount_per_so_line"/>
                                    <field name="price_subtotal" sum="Subtotal" groups="account.group_show_line_subtotals_tax"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_isl_sale_order_tree" model="ir.ui.view">
        <field name="name">farm.sale.order.tree</field>
        <field name="model">farm.sale.order</field>
        <field name="arch" type="xml">
            <list string="ISL Sale Orders">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="date_order"/>
                <field name="amount_total"/>
                <field name="industry_type"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="action_isl_sale_order" model="ir.actions.act_window">
        <field name="name">ISL Sale Orders</field>
        <field name="res_model">farm.sale.order</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>