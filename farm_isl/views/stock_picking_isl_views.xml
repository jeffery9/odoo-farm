<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record id="view_isl_stock_picking_form" model="ir.ui.view">
        <field name="name">farm.stock.picking.form</field>
        <field name="model">farm.stock.picking</field>
        <field name="arch" type="xml">
            <form string="ISL Stock Picking">
                <header>
                    
                    
                    
                    
                    
                    <field name="state" widget="statusbar" statusbar_visible="draft,waiting,confirmed,assigned,done,cancel"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="picking_type_id" invisible="1"/>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="industry_type"/>
                            <field name="is_isl_model"/>
                            <field name="temperature_control"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Industry Specific" invisible="industry_type != 'field_crop' and industry_type != 'livestock'">
                            <group>
                                <field name="temperature_log" placeholder="Temperature monitoring log"/>
                                <field name="humidity_log" placeholder="Humidity monitoring log"/>
                            </group>
                        </page>
                        <page string="Industry Specific" invisible="industry_type != 'field_crop'">
                            <group>
                                <field name="chain_of_custody" placeholder="Food chain of custody documentation"/>
                            </group>
                        </page>
                        <page string="Industry Specific" invisible="industry_type != 'livestock'">
                            <group>
                                <field name="security_seal" placeholder="Pharmaceutical security seal"/>
                            </group>
                        </page>
                        <page string="General Industry Info">
                            <group>
                                <field name="shelf_life_tracking"/>
                                <field name="batch_tracking"/>
                                <field name="lot_tracking"/>
                                <field name="expiry_tracking"/>
                                <field name="humidity_control"/>
                                <field name="light_sensitive"/>
                            </group>
                        </page>
                        
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_isl_stock_picking_tree" model="ir.ui.view">
        <field name="name">farm.stock.picking.tree</field>
        <field name="model">farm.stock.picking</field>
        <field name="arch" type="xml">
            <list string="ISL Stock Pickings">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="picking_type_id"/>
                <field name="scheduled_date"/>
                <field name="industry_type"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="action_isl_stock_picking" model="ir.actions.act_window">
        <field name="name">ISL Stock Pickings</field>
        <field name="res_model">farm.stock.picking</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>