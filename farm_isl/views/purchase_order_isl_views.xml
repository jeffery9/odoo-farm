<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ISL Purchase Order Views -->
    <record id="view_isl_purchase_order_form" model="ir.ui.view">
        <field name="name">farm.purchase.order.form</field>
        <field name="model">farm.purchase.order</field>
        <field name="arch" type="xml">
            <form string="ISL Purchase Order">
                <header>
                    <button name="button_confirm" type="object" string="Confirm Order" class="oe_highlight" invisible="state in ('purchase', 'done', 'cancel')"/>
                    <button name="button_cancel" type="object" string="Cancel Order" invisible="state in ('draft', 'sent', 'cancel')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,sent,purchase,done,cancel"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_invoice" type="object" class="oe_stat_button" icon="fa-pencil-square-o" invisible="invoice_count == 0">
                            <field name="invoice_count" string="Bills" widget="statinfo"/>
                        </button>
                        <button name="action_create_invoice" type="object" string="Create Bill" class="oe_stat_button" icon="fa-plus" invisible="state != 'purchase' or invoice_status != 'to invoice'"/>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" context="{'res_partner_search_mode': 'supplier', 'show_address': 1}" options='{"always_reload": True}'/>
                            <field name="date_order"/>
                            <field name="currency_id"/>
                        </group>
                        <group>
                            <field name="industry_type"/>
                            <field name="industry_certification"/>
                            <field name="is_isl_model"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Industry Specific" invisible="industry_type != 'food_processing'">
                            <group>
                                <field name="certificate_verification" placeholder="Food ingredient certificate verification"/>
                                <field name="incoming_inspection" placeholder="Food incoming inspection procedures"/>
                            </group>
                        </page>
                        <page string="Industry Specific" invisible="industry_type != 'pharmaceutical'">
                            <group>
                                <field name="quality_agreement" placeholder="Pharmaceutical quality agreement"/>
                                <field name="supplier_certification" placeholder="Pharmaceutical supplier certification"/>
                            </group>
                        </page>
                        <page string="Industry Specific" invisible="industry_type != 'chemical'">
                            <group>
                                <field name="incoming_inspection" placeholder="Chemical incoming inspection procedures"/>
                            </group>
                        </page>
                        <page string="General Industry Info">
                            <group>
                                <field name="compliance_requirements"/>
                                <field name="purchase_compliance"/>
                                <field name="quality_assurance"/>
                            </group>
                        </page>
                        <page string="Order Lines">
                            <field name="order_line" nolabel="1" context="{'partner_id': partner_id, 'price_type': 'total'}">
                                <list editable="bottom">
                                    <field name="product_id" domain="[('purchase_ok', '=', True)]"/>
                                    <field name="name"/>
                                    <field name="product_qty"/>
                                    <field name="product_uom" groups="uom.group_uom" options="{'no_create': True}"/>
                                    <field name="price_unit"/>
                                    <field name="taxes_id" widget="many2many_tags" domain="[('type_tax_use','=','purchase'),('company_id','=',parent.company_id)]" groups="account.group_show_line_subtotals_tax"/>
                                    <field name="price_subtotal" sum="Subtotal" groups="account.group_show_line_subtotals_tax"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_isl_purchase_order_tree" model="ir.ui.view">
        <field name="name">farm.purchase.order.tree</field>
        <field name="model">farm.purchase.order</field>
        <field name="arch" type="xml">
            <list string="ISL Purchase Orders">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="date_order"/>
                <field name="amount_total"/>
                <field name="industry_type"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="action_isl_purchase_order" model="ir.actions.act_window">
        <field name="name">ISL Purchase Orders</field>
        <field name="res_model">farm.purchase.order</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>