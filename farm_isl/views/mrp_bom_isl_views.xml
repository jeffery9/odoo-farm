<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record id="view_isl_mrp_bom_form" model="ir.ui.view">
        <field name="name">farm.mrp.bom.form</field>
        <field name="model">farm.mrp.bom</field>
        <field name="arch" type="xml">
            <form string="ISL MRP Bill of Materials">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        
                    </div>
                    <group>
                        <group>
                            <field name="product_tmpl_id"/>
                            <field name="product_id" domain="[('product_tmpl_id', '=', product_tmpl_id)]" context="{'default_product_tmpl_id': product_tmpl_id}"/>
                            
                        </group>
                        <group>
                            <field name="industry_type"/>
                            <field name="industry_specialization"/>
                            <field name="is_isl_model"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Industry Specific" invisible="industry_type != 'food_processing'">
                            <group>
                                <field name="allergen_control"/>
                                <field name="recipe_validation" placeholder="Recipe validation for food processing"/>
                            </group>
                        </page>
                        <page string="Industry Specific" invisible="industry_type != 'pharmaceutical'">
                            <group>
                                <field name="active_ingredient" placeholder="Active pharmaceutical ingredient"/>
                            </group>
                        </page>
                        <page string="Industry Specific" invisible="industry_type != 'chemical'">
                            <group>
                                <field name="safety_coefficient"/>
                                <field name="ingredient_compliance" placeholder="Chemical ingredient compliance"/>
                            </group>
                        </page>
                        <page string="General Industry Info">
                            <group>
                                <field name="compliance_requirements"/>
                                <field name="industry_standards"/>
                                <field name="quality_control_points"/>
                            </group>
                        </page>
                        <page string="Components">
                            <field name="bom_line_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="product_qty"/>
                                    <field name="product_uom_id" groups="uom.group_uom"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_isl_mrp_bom_tree" model="ir.ui.view">
        <field name="name">farm.mrp.bom.tree</field>
        <field name="model">farm.mrp.bom</field>
        <field name="arch" type="xml">
            <list string="ISL MRP Bills of Materials">
                <field name="code"/>
                <field name="product_tmpl_id"/>
                
                <field name="industry_type"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_isl_mrp_bom" model="ir.actions.act_window">
        <field name="name">ISL MRP BOMs</field>
        <field name="res_model">farm.mrp.bom</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>