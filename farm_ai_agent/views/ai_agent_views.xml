<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- AICoordinationLayer Form View -->
    <record id="view_ai_coordination_layer_form" model="ir.ui.view">
        <field name="name">agri.ai.coordination.layer.form</field>
        <field name="model">agri.ai.coordination.layer</field>
        <field name="arch" type="xml">
            <form string="AI Coordination Layer">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="coordination_type"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="industry_type"/>
                            <field name="uses_isl_data"/>
                            <field name="data_isolation_level"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Configuration">
                            <group>
                                <field name="coordination_config" widget="ace" options="{'mode': 'json'}"/>
                                <field name="execution_context" widget="ace" options="{'mode': 'json'}"/>
                                <field name="result_aggregation_method"/>
                            </group>
                        </page>
                        <page string="AI Services">
                            <group>
                                <field name="ai_decision_ids" widget="many2many_tags"/>
                                <field name="ai_vision_ids" widget="many2many_tags"/>
                                <field name="ai_financial_ids" widget="many2many_tags"/>
                            </group>
                        </page>
                        <page string="Execution">
                            <group>
                                <field name="last_execution"/>
                                <field name="execution_count"/>
                                <field name="performance_metrics" widget="ace" options="{'mode': 'json'}"/>
                            </group>
                        </page>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- AICoordinationLayer Tree View -->
    <record id="view_ai_coordination_layer_tree" model="ir.ui.view">
        <field name="name">agri.ai.coordination.layer.tree</field>
        <field name="model">agri.ai.coordination.layer</field>
        <field name="arch" type="xml">
            <list string="AI Coordination Layers">
                <field name="name"/>
                <field name="coordination_type"/>
                <field name="active"/>
                <field name="last_execution"/>
                <field name="execution_count"/>
            </list>
        </field>
    </record>

    <!-- AIAgentWorkflow Form View -->
    <record id="view_ai_agent_workflow_form" model="ir.ui.view">
        <field name="name">agri.ai.agent.workflow.form</field>
        <field name="model">agri.ai.agent.workflow</field>
        <field name="arch" type="xml">
            <form string="AI Agent Workflow">
                <header>
                    <button name="execute_workflow" type="object" string="Execute Workflow" class="oe_highlight"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="coordination_layer_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Steps">
                            <field name="step_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="step_type"/>
                                    <field name="condition"/>
                                </list>
                            </field>
                        </page>
                        <page string="Configuration">
                            <group>
                                <field name="workflow_definition" widget="ace" options="{'mode': 'json'}"/>
                                <field name="trigger_conditions" widget="ace" options="{'mode': 'json'}"/>
                            </group>
                        </page>
                        <page string="Execution">
                            <group>
                                <field name="execution_count"/>
                                <field name="last_execution"/>
                                <field name="success_rate"/>
                            </group>
                        </page>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- AIAgentWorkflow Tree View -->
    <record id="view_ai_agent_workflow_tree" model="ir.ui.view">
        <field name="name">agri.ai.agent.workflow.tree</field>
        <field name="model">agri.ai.agent.workflow</field>
        <field name="arch" type="xml">
            <list string="AI Agent Workflows">
                <field name="name"/>
                <field name="active"/>
                <field name="execution_count"/>
                <field name="success_rate"/>
                <field name="last_execution"/>
            </list>
        </field>
    </record>

    <!-- AIAgentWorkflowStep Form View -->
    <record id="view_ai_agent_workflow_step_form" model="ir.ui.view">
        <field name="name">agri.ai.agent.workflow.step.form</field>
        <field name="model">agri.ai.agent.workflow.step</field>
        <field name="arch" type="xml">
            <form string="AI Agent Workflow Step">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="step_type"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="workflow_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Configuration">
                            <group>
                                <field name="coordination_layer_id" attrs="{'invisible': [('step_type', '!=', 'ai_coordination')], 'required': [('step_type', '=', 'ai_coordination')]}"/>
                                <field name="ai_agent_id" attrs="{'invisible': [('step_type', '!=', 'ai_decision')], 'required': [('step_type', '=', 'ai_decision')]}"/>
                                <field name="ai_vision_service_id" attrs="{'invisible': [('step_type', '!=', 'ai_vision')], 'required': [('step_type', '=', 'ai_vision')]}"/>
                                <field name="ai_financial_service_id" attrs="{'invisible': [('step_type', '!=', 'ai_financial')], 'required': [('step_type', '=', 'ai_financial')]}"/>
                                <field name="step_config" widget="ace" options="{'mode': 'json'}"/>
                            </group>
                        </page>
                        <page string="Conditions and Actions">
                            <group>
                                <field name="condition" widget="ace" options="{'mode': 'python'}"/>
                                <field name="action_code" widget="ace" options="{'mode': 'python'}"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Menu Items for Coordination Layer -->
    <record id="action_ai_coordination_layer" model="ir.actions.act_window">
        <field name="name">Coordination Layers</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">agri.ai.coordination.layer</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add your first AI Coordination Layer!
            </p><p>
                Define coordination layers to integrate between different AI modules like
                vision, decision, and financial AI services.
            </p>
        </field>
    </record>

    <record id="action_ai_agent_workflow" model="ir.actions.act_window">
        <field name="name">AI Agent Workflows</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">agri.ai.agent.workflow</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first AI Agent Workflow!
            </p><p>
                Define complex workflows that coordinate between multiple AI agents to
                accomplish complex agricultural decisions.
            </p>
        </field>
    </record>

    <menuitem id="menu_ai_coordination_layer"
              name="Coordination Layers"
              parent="farm_ai_agent_coordination_menu"
              action="action_ai_coordination_layer"
              sequence="10"/>

    <menuitem id="menu_ai_agent_workflow"
              name="Agent Workflows"
              parent="farm_ai_agent_coordination_menu"
              action="action_ai_agent_workflow"
              sequence="20"/>

</odoo>