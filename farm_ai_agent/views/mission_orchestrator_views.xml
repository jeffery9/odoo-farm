<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ai_autonomous_orchestrator_tree" model="ir.ui.view">
        <name>ai.autonomous.orchestrator.list</name>
        <model>ai.autonomous.orchestrator</model>
        <arch type="xml">
            <list>
                <field name="name"/>
                <field name="auto_dispatch_threshold"/>
                <field name="active"/>
            </list>
        </arch>
    </record>

    <record id="view_ai_autonomous_orchestrator_form" model="ir.ui.view">
        <name>ai.autonomous.orchestrator.form</name>
        <model>ai.autonomous.orchestrator</model>
        <arch type="xml">
            <form>
                <header>
                    <button name="action_run_autonomous_scan" string="Run Autonomous Scan (Manual)" type="object" class="oe_highlight"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Orchestrator Name..."/></h1>
                    </div>
                    <group>
                        <group string="Control Strategy (L5)">
                            <field name="workflow_id"/>
                            <field name="auto_dispatch_threshold"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Autonomous Dispatch Logs" name="logs">
                            <field name="log_ids" readonly="1">
                                <list>
                                    <field name="create_date"/>
                                    <field name="twin_id"/>
                                    <field name="mission_id"/>
                                    <field name="status"/>
                                    <field name="detail"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </arch>
    </record>

    <record id="action_ai_autonomous_orchestrator" model="ir.actions.act_window">
        <name>Autonomous Mission Orchestrators</name>
        <res_model>ai.autonomous.orchestrator</res_model>
        <view_mode>list,form</view_mode>
    </record>

    <menuitem id="menu_autonomous_dispatch"
              name="Autonomous Dispatch (L5)"
              parent="farm_ai_agent.menu_ai_agent_root"
              action="action_ai_autonomous_orchestrator"
              sequence="20"/>
</odoo>
