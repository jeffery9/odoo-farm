<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record id="view_precision_metrology_wizard_form" model="ir.ui.view">
        <field name="name">precision.metrology.wizard.form</field>
        <field name="model">precision.metrology.wizard</field>
        <field name="arch" type="xml">
            <form string="Input Execution Data">
                <header>
                    <button name="action_apply_and_calculate" string="Calculate &amp; Intervene" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" name="%(action_precision_phase_execution_board)d" type="action" icon="fa-list">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Phase Board</span>
                            </div>
                        </button>
                    </div>
                    <group>
                        <group string="Process Context">
                            <field name="production_id" readonly="1"/>
                            <field name="phase_id" readonly="1"/>
                        </group>
                        <group string="Measurement">
                            <field name="parameter_id" options="{'no_create': True}"/>
                            <field name="target_value"/>
                            <field name="actual_value"/>
                            <field name="uom_id" readonly="1"/>
                        </group>
                    </group>

                    
                    <group string="Batch Processing" invisible="len(phase_ids) &lt; 2">
                        <field name="phase_ids" nolabel="1" widget="many2many_tags"
                               domain="[('production_id', '=', production_id)]"
                               readonly="actual_value != False"/>
                        <div class="text-info" invisible="not phase_ids">
                            <i class="fa fa-info-circle"/> Multiple phases selected for batch processing
                        </div>
                    </group>

                    
                    <group string="Validation">
                        <group>
                            <field name="deviation_percent" invisible="1"/>
                        </group>
                        <group>
                            <div class="alert alert-info" role="alert"
                                 invisible="not deviation_percent or abs(deviation_percent) &lt;= 10.0">
                                <i class="fa fa-exclamation-triangle"/>
                                <strong>Warning:</strong> Deviation exceeds tolerance. Process control may trigger adaptations.
                            </div>
                            <div class="alert alert-danger" role="alert"
                                 invisible="not deviation_percent or abs(deviation_percent) &lt;= 25.0">
                                <i class="fa fa-lock"/>
                                <strong>CRITICAL:</strong> Severe deviation detected. Process will be locked for safety.
                            </div>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>