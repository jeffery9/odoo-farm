<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Modern Recipe Execution Dashboard -->
    <record id="recipe_execution_dashboard_view_kanban" model="ir.ui.view">
        <field name="name">recipe.execution.dashboard.kanban</field>
        <field name="model">mrp.production</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" create="false" js_class="precision_execution_dashboard">
                <field name="name"/>
                <field name="state"/>
                <field name="yield_confidence"/>
                <field name="efficiency_index"/>
                <field name="process_status"/>
                <field name="active_recipe_phase_id"/>
                <field name="progress_percentage"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="o_kanban_global_click o_kanban_record oe_kanban_quick_create card border-0 shadow-sm h-100">
                            <div class="card-body p-3">
                                <!-- Progress Header -->
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <h6 class="card-title mb-0 text-primary fw-bold">
                                        <field name="name"/>
                                    </h6>
                                    <span t-attf-class="badge #{record.process_status.raw_value == 'stable' ? 'bg-success' : (record.process_status.raw_value == 'drifting' ? 'bg-warning' : 'bg-danger')}">
                                        <field name="process_status"/>
                                    </span>
                                </div>

                                <!-- Active Phase Indicator -->
                                <div class="mb-2">
                                    <small class="text-muted">Active Phase:</small>
                                    <div class="fw-semibold">
                                        <field name="active_recipe_phase_id" placeholder="No Active Phase"/>
                                    </div>
                                </div>

                                <!-- Progress Bar -->
                                <div class="progress mb-2" style="height: 8px;">
                                    <div class="progress-bar"
                                         t-attf-style="width: #{record.progress_percentage.raw_value || 0}%;"
                                         t-attf-class="progress-bar #{record.state.raw_value == 'progress' ? 'bg-info' : (record.state.raw_value == 'done' ? 'bg-success' : 'bg-secondary')}">
                                    </div>
                                </div>

                                <!-- KPI Cards -->
                                <div class="row g-1 mt-1">
                                    <div class="col-4">
                                        <div class="text-center">
                                            <div class="fw-bold" t-attf-style="color: #{record.yield_confidence.raw_value >= 90 ? 'green' : (record.yield_confidence.raw_value >= 70 ? 'orange' : 'red')}">
                                                <field name="yield_confidence" widget="float" digits="[12,1]"/>%
                                            </div>
                                            <small class="text-muted">Yield</small>
                                        </div>
                                    </div>
                                    <div class="col-4">
                                        <div class="text-center">
                                            <div class="fw-bold" t-attf-style="color: #{record.efficiency_index.raw_value >= 1.0 ? 'green' : 'red'}">
                                                <field name="efficiency_index" widget="float" digits="[12,2]"/>
                                            </div>
                                            <small class="text-muted">Eff</small>
                                        </div>
                                    </div>
                                    <div class="col-4">
                                        <div class="text-center">
                                            <div class="fw-bold">
                                                <field name="quality_score" widget="float" digits="[12,1]"/>
                                            </div>
                                            <small class="text-muted">Qual</small>
                                        </div>
                                    </div>
                                </div>

                                <!-- Quick Action Buttons -->
                                <div class="d-grid gap-1 mt-3">
                                    <button name="action_next_phase"
                                            type="object"
                                            class="btn btn-sm btn-success"
                                            invisible="active_recipe_phase_id == False or is_process_locked == True"
                                            title="Next Phase">
                                        <i class="fa fa-arrow-right"/> Next
                                    </button>
                                    <button name="action_open_metrology_wizard"
                                            type="object"
                                            class="btn btn-sm btn-info"
                                            invisible="active_recipe_phase_id == False or is_process_locked == True"
                                            title="Record Metrology">
                                        <i class="fa fa-bar-chart"/> Record
                                    </button>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Enhanced Form View with Modern UX -->
    <record id="mrp_production_form_view_enhanced" model="ir.ui.view">
        <field name="name">mrp.production.form.enhanced.precision</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp_production_form_view_inherit_precision_ultimate"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
<header>

                <!-- Modern Execution Controls -->
                <div class="o_statusbar_status d-flex align-items-center" style="min-height: 40px;">
                    <div class="d-flex flex-wrap">
                        <field name="skill_execution_status" widget="statusbar"
                               statusbar_visible="idle,triggered,executing,success,failed"
                               invisible="production_drive_type != 'parameter'"/>
                    </div>
                </div>
            
</header>
</xpath>

            <!-- Replace the stat box with a more modern version -->
            <xpath expr="//div[@name='button_box']" position="replace">
                <div class="o_button_box d-flex flex-wrap justify-content-center p-2 bg-light border rounded-2 mb-3">
                    <div class="d-flex flex-column align-items-center mx-2 px-2 py-1 border-end">
                        <field name="yield_confidence" widget="stat_info" options="{'field': 'yield_confidence', 'unit': '%'}"/>
                        <small class="text-muted mt-1">Yield Confidence</small>
                    </div>
                    <div class="d-flex flex-column align-items-center mx-2 px-2 py-1 border-end">
                        <field name="efficiency_index" widget="stat_info" options="{'field': 'efficiency_index', 'decimal_precision': 2}"/>
                        <small class="text-muted mt-1">Efficiency</small>
                    </div>
                    <div class="d-flex flex-column align-items-center mx-2 px-2 py-1 border-end">
                        <field name="quality_score" widget="stat_info" options="{'field': 'quality_score', 'decimal_precision': 1}"/>
                        <small class="text-muted mt-1">Quality Score</small>
                    </div>
                    <div class="d-flex flex-column align-items-center mx-2 px-2">
                        <div class="d-flex align-items-center">
                            <i class="fa fa-shield" t-attf-class="me-1 #{process_status == 'stable' ? 'text-success' : (process_status == 'drifting' ? 'text-warning' : 'text-danger')}"/>
                            <field name="process_status" widget="status_widget"/>
                        </div>
                        <small class="text-muted mt-1">Stability</small>
                    </div>
                </div>
            </xpath>

            <!-- Add a modern phase timeline visualization -->
            <xpath expr="//page[@name='control_recipe']" position="before">
                <page name="phase_timeline" string="📊 Phase Timeline" invisible="production_drive_type != 'parameter'">
                    <div class="row">
                        <div class="col-12">
                            <div class="o_timeline_container">
                                <field name="recipe_phase_ids"
                                       widget="precision_phase_timeline"
                                       context="{'form_view_ref': 'precision_production.precision_recipe_phase_form_view'}"/>
                            </div>
                        </div>
                    </div>
                </page>
            </xpath>

            <!-- Enhance the performance page with charts -->
            <xpath expr="//page[@name='precision_performance']" position="inside">
                <div class="row mt-3">
                    <div class="col-md-6">
                        <div class="card">
                            <div class="card-header">
                                <h5 class="card-title mb-0">📈 Parameter Trends</h5>
                            </div>
                            <div class="card-body">
                                <field name="recipe_phase_ids"
                                       widget="precision_parameter_chart"
                                       context="{'form_view_ref': 'precision_production.precision_recipe_parameter_form_view'}"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card">
                            <div class="card-header">
                                <h5 class="card-title mb-0">📋 Recent Interventions</h5>
                            </div>
                            <div class="card-body">
                                <field name="intervention_ids"
                                       nolabel="1"
                                       options="{'reload_on_button': true}"
                                       context="{'form_view_ref': 'precision_production.precision_intervention_form_view'}">
                                    <list decoration-info="intervention_type == 'active'"
                                          decoration-bf="intervention_type == 'active'">
                                        <field name="create_date"/>
                                        <field name="intervention_type"/>
                                        <field name="name"/>
                                        <field name="user_id"/>
                                    </list>
                                </field>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <!-- Modern Phase Execution View -->
    <record id="precision_recipe_phase_view_kanban_modern" model="ir.ui.view">
        <field name="name">precision.recipe.phase.kanban.modern</field>
        <field name="model">precision.recipe.phase</field>
        <field name="inherit_id" ref="precision_recipe_phase_view_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="attributes">
                <attribute name="js_class">precision_phase_kanban</attribute>
            </xpath>
            <xpath expr="//t[@t-name='kanban-box']" position="replace">
                <t t-name="kanban-box">
                    <div t-attf-class="oe_kanban_global_click shadow-sm card h-100 border-0 #{record.state.raw_value == 'progress' ? 'border-info border-2' : (record.state.raw_value == 'done' ? 'border-success border-2' : 'border-light')}">
                        <div class="card-body p-3">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h6 class="card-title mb-0 fw-bold">
                                    <field name="name"/>
                                </h6>
                                <field name="state" widget="label_selection"
                                       options="{'classes': {'pending': 'bg-light text-dark', 'progress': 'bg-info text-light', 'done': 'bg-success text-light'}, 'variant': 'pill'}"/>
                            </div>

                            <div class="mb-2">
                                <small class="text-muted">Production:</small>
                                <div class="fw-semibold">
                                    <field name="production_id"/>
                                </div>
                            </div>

                            <div class="mb-2">
                                <small class="text-muted">Equipment:</small>
                                <div>
                                    <i class="fa fa-cube me-1"/> <field name="required_workcenter_id"/>
                                </div>
                            </div>

                            <div class="progress mb-2" style="height: 6px;">
                                <div class="progress-bar"
                                     t-attf-style="width: #{record.duration_actual.raw_value ? (record.duration_actual.raw_value / record.duration_planned.raw_value * 100) : 0}%;"
                                     t-attf-class="progress-bar #{record.duration_actual.raw_value > record.duration_planned.raw_value ? 'bg-warning' : 'bg-info'}">
                                </div>
                            </div>

                            <div class="d-grid gap-2 mt-3">
                                <button name="action_start_phase"
                                        type="object"
                                        class="btn btn-sm btn-outline-primary"
                                        invisible="state != 'pending'"
                                        title="Start Phase">
                                    <i class="fa fa-play"/> Start
                                </button>
                                <button name="action_end_phase"
                                        type="object"
                                        class="btn btn-sm btn-success"
                                        invisible="state != 'progress'"
                                        title="Finish Phase">
                                    <i class="fa fa-check"/> Finish
                                </button>
                            </div>
                        </div>
                    </div>
                </t>
            </xpath>
        </field>
    </record>

    <!-- Action for the Modern Dashboard -->
    <record id="action_recipe_execution_dashboard" model="ir.actions.act_window">
        <field name="name">🎯 Recipe Execution Dashboard</field>
        <field name="res_model">mrp.production</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('production_drive_type', '=', 'parameter')]</field>
        <field name="context">{'search_default_state_progress': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Recipe Execution Dashboard
            </p>
            <p>Monitor and control precision recipe execution with real-time KPIs and streamlined actions.</p>
        </field>
    </record>

    <menuitem id="menu_recipe_execution_dashboard"
              name="🎯 Recipe Dashboard"
              parent="mrp.menu_mrp_manufacturing"
              action="action_recipe_execution_dashboard"
              sequence="20"/>
</odoo>