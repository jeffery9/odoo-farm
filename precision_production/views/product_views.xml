<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_bom_form_inherit_master_recipe_ultimate" model="ir.ui.view">
        <field name="name">mrp.bom.form.inherit.master.recipe.ultimate</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="production_drive_type" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='product_tmpl_id']" position="after">
                <field name="required_workcenter_id" invisible="production_drive_type != 'parameter'"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Master Recipe (主配方)" invisible="production_drive_type != 'parameter'">
                    <div class="alert alert-info d-flex align-items-center" role="alert">
                         <i class="fa fa-flask fa-2x me-3"/>
                         <div>
                            <strong>Batch Size Mode:</strong> This recipe is defined for a base quantity of 
                            <field name="recipe_batch_size" class="fw-bold"/> 
                            <field name="product_uom_id" readonly="1" class="ms-1"/>. 
                            MO quantities will scale materials and scalable parameters accordingly.
                         </div>
                    </div>
                    <field name="master_recipe_phase_ids" nolabel="1">
                        <list string="Master Phases">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="required_role"/>
                            <field name="duration_expected" widget="float_time"/>
                        </list>
                        <form>
                            <sheet>
                                <group>
                                    <group string="Phase Definition">
                                        <field name="name"/><field name="sequence"/>
                                        <field name="duration_expected" widget="float_time"/>
                                    </group>
                                    <group string="Constraints">
                                        <field name="required_workcenter_id"/>
                                        <field name="required_role"/>
                                    </group>
                                </group>
                                <notebook>
                                    <page string="Master Parameters">
                                        <field name="master_parameter_ids">
                                            <list editable="bottom">
                                                <field name="name"/><field name="target_value"/><field name="uom_id"/>
                                                <field name="is_scalable" widget="boolean_toggle" string="Scales?"/>
                                                <field name="tolerance_percent"/>
                                            </list>
                                        </field>
                                    </page>
                                    <page string="Phase Materials">
                                        <field name="master_material_ids">
                                            <list editable="bottom">
                                                <field name="product_id"/><field name="quantity" string="Qty (per Batch)"/><field name="uom_id"/>
                                            </list>
                                        </field>
                                    </page>
                                </notebook>
                            </sheet>
                        </form>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>