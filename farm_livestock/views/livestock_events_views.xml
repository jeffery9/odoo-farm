<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Livestock Lifecycle Events -->
    <record id="view_farm_livestock_event_tree" model="ir.ui.view">
        <field name="name">farm.livestock.event.tree</field>
        <field name="model">farm.livestock.event</field>
        <field name="arch" type="xml">
            <list string="Livestock Events">
                <field name="event_date"/>
                <field name="lot_id"/>
                <field name="event_type" widget="badge" decoration-info="event_type == 'birth'" decoration-warning="event_type == 'death'"/>
                <field name="responsible_id"/>
                <field name="notes"/>
            </list>
        </field>
    </record>

    <record id="view_farm_livestock_event_form" model="ir.ui.view">
        <field name="name">farm.livestock.event.form</field>
        <field name="model">farm.livestock.event</field>
        <field name="arch" type="xml">
            <form string="Livestock Event">
                <sheet>
                    <group>
                        <group>
                            <field name="lot_id"/>
                            <field name="event_type"/>
                            <field name="event_date"/>
                        </group>
                        <group>
                            <field name="responsible_id"/>
                            <field name="location_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Event Details">
                            <group>
                                <field name="measured_weight" invisible="event_type != 'weight'"/>
                                <field name="medicine_id" invisible="event_type not in ('vaccination', 'treatment')"/>
                                <field name="dosage" invisible="event_type not in ('vaccination', 'treatment')"/>
                                <field name="uom_id" invisible="event_type not in ('vaccination', 'treatment')"/>
                            </group>
                            <group string="Anomaly Tracking" invisible="not is_anomaly">
                                <field name="is_anomaly"/>
                                <field name="alert_severity"/>
                            </group>
                        </page>
                        <page string="Notes">
                            <field name="notes" placeholder="Additional observations..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- House Environment Logs -->
    <record id="view_farm_livestock_house_env_tree" model="ir.ui.view">
        <field name="name">farm.livestock.house.env.tree</field>
        <field name="model">farm.livestock.house.env</field>
        <field name="arch" type="xml">
            <list string="House Environment">
                <field name="capture_time"/>
                <field name="location_id"/>
                <field name="temperature"/>
                <field name="humidity"/>
                <field name="ammonia_level"/>
                <field name="comfort_index" widget="progressbar"/>
            </list>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_farm_livestock_event" model="ir.actions.act_window">
        <field name="name">Lifecycle Events</field>
        <field name="res_model">farm.livestock.event</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_farm_livestock_house_env" model="ir.actions.act_window">
        <field name="name">Environment Monitoring</field>
        <field name="res_model">farm.livestock.house.env</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
