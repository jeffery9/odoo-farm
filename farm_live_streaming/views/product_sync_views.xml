<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>
    <record id="action_product_sync" model="ir.actions.act_window">
        <field name="name">Product Sync with Douyin</field>
        <field name="res_model">douyin.product</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_product_sync_tree" model="ir.ui.view">
        <field name="name">douyin.product.tree</field>
        <field name="model">douyin.product</field>
        <field name="arch" type="xml">
            <list string="Product Sync Status" decoration-danger="sync_state=='error'" decoration-success="sync_state=='synced'">
                <field name="product_id" />
                <field name="account_id" />
                <field name="douyin_item_id" />
                <field name="sync_state" widget="badge" />
                <field name="last_sync_time" />
            </list>
        </field>
    </record>

    <record id="view_product_sync_form" model="ir.ui.view">
        <field name="name">douyin.product.form</field>
        <field name="model">douyin.product</field>
        <field name="arch" type="xml">
            <form string="Product Sync">
                <header>
                    <button name="action_sync_to_douyin" type="object" string="Sync Now" class="oe_highlight" />
                    <field name="sync_state" widget="statusbar" />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="product_id" />
                            <field name="account_id" />
                        </group>
                        <group>
                            <field name="douyin_item_id" />
                            <field name="last_sync_time" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <menuitem id="menu_product_sync" name="Product Sync" parent="menu_douyin_config" action="action_product_sync" sequence="30" />
</data>
</odoo>
