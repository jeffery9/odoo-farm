<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>
    <record id="action_live_statistics" model="ir.actions.act_window">
        <field name="name">Live Streaming Sessions</field>
        <field name="res_model">live.streaming.session</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_live_statistics_tree" model="ir.ui.view">
        <field name="name">live.streaming.session.tree</field>
        <field name="model">live.streaming.session</field>
        <field name="arch" type="xml">
            <list string="Live Sessions" decoration-info="state == 'live'" decoration-success="state == 'ended'">
                <field name="name" />
                <field name="account_id" />
                <field name="start_time" />
                <field name="end_time" />
                <field name="view_count" />
                <field name="like_count" />
                <field name="comment_count" />
                <field name="total_sales" />
                <field name="state" widget="badge" />
            </list>
        </field>
    </record>

    <record id="view_live_statistics_form" model="ir.ui.view">
        <field name="name">live.streaming.session.form</field>
        <field name="model">live.streaming.session</field>
        <field name="arch" type="xml">
            <form string="Live Session">
                <header>
                    <button name="action_start_live" type="object" string="Start Live" class="oe_highlight" invisible="state != 'planned'" />
                    <button name="action_end_live" type="object" string="End Live" class="oe_highlight" invisible="state != 'live'" />
                    <button name="action_refresh_stats" type="object" string="Refresh Statistics" class="btn-secondary" invisible="state != 'live'" />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" />
                        <h1><field name="name" placeholder="Session Title" /></h1>
                    </div>
                    <group>
                        <group string="Schedule &amp; Account">
                            <field name="account_id" />
                            <field name="start_time" />
                            <field name="end_time" />
                            <field name="dy_room_id" />
                        </group>
                        <group string="Live Statistics">
                            <field name="view_count" />
                            <field name="like_count" />
                            <field name="comment_count" />
                            <field name="total_sales" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Featured Products" name="products">
                            <field name="product_ids" widget="many2many_tags" />
                        </page>
                        <page string="Archive &amp; Replay" name="archive">
                            <group>
                                <field name="archive_url" widget="url" />
                                <field name="video_binary" filename="name" />
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <menuitem id="menu_live_statistics" name="Live Sessions" parent="menu_douyin_config" action="action_live_statistics" sequence="50" />
</data>
</odoo>
