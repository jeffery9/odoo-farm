<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_iiot_gateway_tree" model="ir.ui.view">
        <field name="name">iiot.gateway.list</field>
        <field name="model">iiot.gateway</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="gateway_id"/>
                <field name="url"/>
                <field name="state" widget="badge" decoration-success="state == 'online'" decoration-muted="state == 'offline'"/>
                <field name="last_seen"/>
            </list>
        </field>
    </record>

    <record id="view_iiot_gateway_form" model="ir.ui.view">
        <field name="name">iiot.gateway.form</field>
        <field name="model">iiot.gateway</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_ping" string="Ping Gateway" type="object" class="oe_highlight" invisible="state == 'offline'"/>
                    <button name="action_sync_subscriptions" string="Sync Subscriptions" type="object" invisible="state == 'offline'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="gateway_id"/>
                            <field name="url"/>
                        </group>
                        <group>
                            <field name="last_seen"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Managed Devices" name="devices">
                            <field name="device_ids"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_iiot_gateway" model="ir.actions.act_window">
        <field name="name">IoT Gateways</field>
        <field name="res_model">iiot.gateway</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_iiot_gateway" name="Gateways" 
              parent="menu_iiot_root" action="action_iiot_gateway" sequence="40"/>
</odoo>
