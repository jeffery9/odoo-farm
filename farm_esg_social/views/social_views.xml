<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record id="view_social_diversity_metric_tree" model="ir.ui.view">
        <field name="name">farm.esg.social.diversity.metric.tree</field>
        <field name="model">farm.esg.social.diversity.metric</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="reporting_period"/>
                <field name="total_employees"/>
                <field name="gender_balance_ratio"/>
                <field name="local_employment_ratio"/>
            </list>
        </field>
    </record>

    <record id="view_social_diversity_metric_form" model="ir.ui.view">
        <field name="name">farm.esg.social.diversity.metric.form</field>
        <field name="model">farm.esg.social.diversity.metric</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="reporting_period"/>
                        </group>
                        <group>
                            <field name="total_employees"/>
                            <field name="gender_balance_ratio"/>
                            <field name="local_employment_ratio"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Gender Distribution">
                            <group>
                                <field name="gender_male_count"/>
                                <field name="gender_female_count"/>
                                <field name="gender_other_count"/>
                            </group>
                        </page>
                        <page string="Age Distribution">
                            <group>
                                <field name="age_under_30"/>
                                <field name="age_30_to_50"/>
                                <field name="age_over_50"/>
                            </group>
                        </page>
                        <page string="Employment Types">
                            <group>
                                <field name="disability_employment"/>
                                <field name="local_community_employment"/>
                                <field name="temporary_contract_count"/>
                                <field name="full_time_count"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_social_diversity_metric" model="ir.actions.act_window">
        <field name="name">Social &amp; Diversity Metrics</field>
        <field name="res_model">farm.esg.social.diversity.metric</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>