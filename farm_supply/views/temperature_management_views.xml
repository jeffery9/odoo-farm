<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Temperature Reading Tree View -->
    <record id="view_temperature_reading_tree" model="ir.ui.view">
        <field name="name">temperature.reading.tree</field>
        <field name="model">temperature.reading</field>
        <field name="arch" type="xml">
            <tree string="Temperature Readings">
                <field name="product_lot_id"/>
                <field name="temperature"/>
                <field name="timestamp"/>
                <field name="location_id"/>
                <field name="humidity"/>
                <field name="is_alert_triggered"/>
            </tree>
        </field>
    </record>

    <!-- Temperature Reading Form View -->
    <record id="view_temperature_reading_form" model="ir.ui.view">
        <field name="name">temperature.reading.form</field>
        <field name="model">temperature.reading</field>
        <field name="arch" type="xml">
            <form string="Temperature Reading">
                <sheet>
                    <group>
                        <group>
                            <field name="product_lot_id"/>
                            <field name="temperature"/>
                            <field name="timestamp"/>
                        </group>
                        <group>
                            <field name="location_id"/>
                            <field name="humidity"/>
                            <field name="is_alert_triggered"/>
                        </group>
                    </group>
                    <field name="notes"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Precooling Temperature Tree View -->
    <record id="view_precooling_temperature_tree" model="ir.ui.view">
        <field name="name">precooling.temperature.tree</field>
        <field name="model">precooling.temperature</field>
        <field name="arch" type="xml">
            <tree string="Pre-cooling Temperature Readings">
                <field name="precooling_process_id"/>
                <field name="temperature"/>
                <field name="timestamp"/>
                <field name="humidity"/>
                <field name="is_alert"/>
            </tree>
        </field>
    </record>

    <!-- Precooling Temperature Form View -->
    <record id="view_precooling_temperature_form" model="ir.ui.view">
        <field name="name">precooling.temperature.form</field>
        <field name="model">precooling.temperature</field>
        <field name="arch" type="xml">
            <form string="Pre-cooling Temperature Reading">
                <sheet>
                    <group>
                        <group>
                            <field name="precooling_process_id"/>
                            <field name="temperature"/>
                            <field name="timestamp"/>
                        </group>
                        <group>
                            <field name="humidity"/>
                            <field name="is_alert"/>
                        </group>
                    </group>
                    <field name="notes"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Menu Items for Temperature Management -->
    <menuitem id="menu_temperature_readings" name="Temperature Readings"
              parent="menu_shelf_life"
              sequence="20">
        <menuitem id="menu_temperature_reading_list" name="Temperature Readings"
                  action="action_temperature_reading_list"
                  sequence="10"/>
    </menuitem>

    <menuitem id="menu_precooling_temperature_readings" name="Pre-cooling Temperatures"
              parent="menu_precooling"
              sequence="20">
        <menuitem id="menu_precooling_temperature_list" name="Temperature Readings"
                  action="action_precooling_temperature_list"
                  sequence="10"/>
    </menuitem>

    <!-- Actions -->
    <record id="action_temperature_reading_list" model="ir.actions.act_window">
        <field name="name">Temperature Readings</field>
        <field name="res_model">temperature.reading</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_precooling_temperature_list" model="ir.actions.act_window">
        <field name="name">Pre-cooling Temperature Readings</field>
        <field name="res_model">precooling.temperature</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>