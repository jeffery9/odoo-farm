<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- VMI Configuration Tree View -->
    <record id="view_input_vmi_configuration_tree" model="ir.ui.view">
        <field name="name">input.vmi.configuration.tree</field>
        <field name="model">input.vmi.configuration</field>
        <field name="arch" type="xml">
            <tree string="VMI Configurations">
                <field name="name"/>
                <field name="product_id"/>
                <field name="supplier_id"/>
                <field name="current_stock_level"/>
                <field name="warning_level_qty"/>
                <field name="danger_level_qty"/>
                <field name="is_vmi_enabled"/>
            </tree>
        </field>
    </record>

    <!-- VMI Configuration Form View -->
    <record id="view_input_vmi_configuration_form" model="ir.ui.view">
        <field name="name">input.vmi.configuration.form</field>
        <field name="model">input.vmi.configuration</field>
        <field name="arch" type="xml">
            <form string="VMI Configuration">
                <header>
                    <button name="action_check_vmi_levels" type="object" string="Check VMI Levels" class="oe_highlight"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="product_id"/>
                            <field name="supplier_id"/>
                        </group>
                        <group>
                            <field name="is_vmi_enabled"/>
                            <field name="is_automated_reorder_enabled"/>
                        </group>
                    </group>
                    <group string="Stock Levels">
                        <group>
                            <field name="current_stock_level"/>
                            <field name="last_stock_update"/>
                        </group>
                        <group>
                            <field name="min_stock_level"/>
                            <field name="max_stock_level"/>
                        </group>
                    </group>
                    <group string="Thresholds">
                        <group>
                            <field name="warning_level_qty"/>
                            <field name="danger_level_qty"/>
                        </group>
                        <group>
                            <field name="auto_reorder_qty"/>
                        </group>
                    </group>
                    <field name="vmi_portal_access_url"/>
                    <notebook>
                        <page string="Sensor Readings" name="readings">
                            <field name="vmi_readings">
                                <tree editable="top">
                                    <field name="sensor_id"/>
                                    <field name="quantity"/>
                                    <field name="temperature"/>
                                    <field name="humidity"/>
                                    <field name="timestamp"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Joint Procurement Configuration Tree View -->
    <record id="view_joint_procurement_config_tree" model="ir.ui.view">
        <field name="name">joint.procurement.configuration.tree</field>
        <field name="model">joint.procurement.configuration</field>
        <field name="arch" type="xml">
            <tree string="Joint Procurement Configurations">
                <field name="name"/>
                <field name="cooperative_id"/>
                <field name="procurement_cycle"/>
                <field name="is_active"/>
                <field name="status"/>
                <field name="next_procurement_date"/>
            </tree>
        </field>
    </record>

    <!-- Joint Procurement Configuration Form View -->
    <record id="view_joint_procurement_config_form" model="ir.ui.view">
        <field name="name">joint.procurement.configuration.form</field>
        <field name="model">joint.procurement.configuration</field>
        <field name="arch" type="xml">
            <form string="Joint Procurement Configuration">
                <header>
                    <button name="action_aggregate_needs" type="object" string="Aggregate Needs" class="oe_highlight"
                            states="planning,aggregation"/>
                    <button name="action_create_joint_orders" type="object" string="Create Joint Orders"
                            states="aggregation,rfq"/>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="cooperative_id"/>
                            <field name="product_category_id"/>
                        </group>
                        <group>
                            <field name="procurement_cycle"/>
                            <field name="is_active"/>
                        </group>
                    </group>
                    <group>
                        <field name="procurement_date"/>
                        <field name="next_procurement_date"/>
                    </group>
                    <field name="members_participating" widget="many2many_tags"/>
                    <notebook>
                        <page string="Aggregated Needs" name="needs">
                            <field name="aggregated_needs">
                                <tree editable="top">
                                    <field name="member_id"/>
                                    <field name="product_id"/>
                                    <field name="requested_quantity"/>
                                    <field name="unit_price"/>
                                    <field name="forecasted_usage_period"/>
                                    <field name="priority"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Joint Orders" name="orders">
                            <field name="joint_orders"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Supply Risk Radar Tree View -->
    <record id="view_supply_risk_radar_tree" model="ir.ui.view">
        <field name="name">supply.risk.radar.tree</field>
        <field name="model">supply.risk.radar</field>
        <field name="arch" type="xml">
            <tree string="Supply Risk Radar"
                  decoration-danger="risk_level == 'critical'"
                  decoration-warning="risk_level == 'high'"
                  decoration-info="risk_level == 'medium'"
                  decoration-muted="risk_level == 'low'">
                <field name="name"/>
                <field name="supplier_id"/>
                <field name="risk_type"/>
                <field name="risk_level"/>
                <field name="estimated_delay_days"/>
                <field name="status"/>
            </tree>
        </field>
    </record>

    <!-- Supply Risk Radar Form View -->
    <record id="view_supply_risk_radar_form" model="ir.ui.view">
        <field name="name">supply.risk.radar.form</field>
        <field name="model">supply.risk.radar</field>
        <field name="arch" type="xml">
            <form string="Supply Risk Radar">
                <header>
                    <button name="action_assess_risk" type="object" string="Assess Risk" class="oe_highlight"
                            states="detected"/>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="supplier_id"/>
                        </group>
                        <group>
                            <field name="risk_type"/>
                            <field name="risk_level"/>
                        </group>
                    </group>
                    <group>
                        <field name="location_affected"/>
                        <field name="estimated_delay_days"/>
                    </group>
                    <field name="impact_description"/>
                    <field name="mitigation_plan"/>
                    <field name="risk_monitoring"/>
                    <field name="alternative_suppliers" widget="many2many_tags"/>
                    <field name="purchase_orders_affected" widget="many2many_tags"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Safe POD Configuration Tree View -->
    <record id="view_safe_pod_config_tree" model="ir.ui.view">
        <field name="name">safe.pod.config.tree</field>
        <field name="model">safe.pod.configuration</field>
        <field name="arch" type="xml">
            <tree string="Safe POD Configurations">
                <field name="name"/>
                <field name="delivery_route"/>
                <field name="delivery_vehicle"/>
                <field name="temperature_control_required"/>
                <field name="is_active"/>
            </tree>
        </field>
    </record>

    <!-- Delivery Tracking Record Tree View -->
    <record id="view_delivery_tracking_record_tree" model="ir.ui.view">
        <field name="name">delivery.tracking.record.tree</field>
        <field name="model">delivery.tracking.record</field>
        <field name="arch" type="xml">
            <tree string="Delivery Tracking Records">
                <field name="name"/>
                <field name="delivery_picking_id"/>
                <field name="delivery_date"/>
                <field name="delivery_status"/>
                <field name="has_temperature_compliance"/>
            </tree>
        </field>
    </record>

    <!-- Delivery Tracking Record Form View -->
    <record id="view_delivery_tracking_record_form" model="ir.ui.view">
        <field name="name">delivery.tracking.record.form</field>
        <field name="model">delivery.tracking.record</field>
        <field name="arch" type="xml">
            <form string="Delivery Tracking Record">
                <header>
                    <button name="action_mark_delivered" type="object" string="Mark as Delivered" class="oe_highlight"
                            states="in_transit,arrived"/>
                    <field name="delivery_status" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="delivery_picking_id"/>
                            <field name="config_id"/>
                        </group>
                        <group>
                            <field name="delivery_date"/>
                            <field name="actual_delivery_date"/>
                        </group>
                    </group>
                    <group string="Temperature Control">
                        <group>
                            <field name="start_temperature"/>
                            <field name="end_temperature"/>
                        </group>
                        <group>
                            <field name="has_temperature_compliance"/>
                        </group>
                    </group>
                    <group string="Delivery Personnel">
                        <field name="delivery_person_id"/>
                    </group>
                    <group string="Delivery Window">
                        <field name="expected_delivery_start"/>
                        <field name="expected_delivery_end"/>
                    </group>
                    <field name="signature_name"/>
                    <field name="receiver_signature" widget="image" class="oe_avatar"/>
                    <field name="delivery_photos" widget="image" class="oe_avatar"/>
                    <field name="delivery_notes"/>
                    <notebook>
                        <page string="Temperature Readings" name="readings">
                            <field name="temperature_readings">
                                <tree editable="top">
                                    <field name="temperature"/>
                                    <field name="humidity"/>
                                    <field name="timestamp"/>
                                    <field name="location_lat"/>
                                    <field name="location_lng"/>
                                    <field name="is_alert_triggered"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Menu Items for VMI and Risk Management -->
    <menuitem id="menu_vmi_management" name="VMI Management"
              parent="menu_supply_chain_root"
              sequence="60">
        <menuitem id="menu_vmi_configurations" name="VMI Configurations"
                  action="action_input_vmi_configuration_list"
                  sequence="10"/>
    </menuitem>

    <menuitem id="menu_joint_procurement" name="Joint Procurement"
              parent="menu_supply_chain_root"
              sequence="70">
        <menuitem id="menu_joint_procurement_configs" name="Joint Procurement Configurations"
                  action="action_joint_procurement_config_list"
                  sequence="10"/>
    </menuitem>

    <menuitem id="menu_supply_risk" name="Supply Risk Management"
              parent="menu_supply_chain_root"
              sequence="80">
        <menuitem id="menu_supply_risk_radar" name="Supply Risk Radar"
                  action="action_supply_risk_radar_list"
                  sequence="10"/>
    </menuitem>

    <menuitem id="menu_safe_pod" name="Safe POD Management"
              parent="menu_supply_chain_root"
              sequence="90">
        <menuitem id="menu_safe_pod_configs" name="Safe POD Configurations"
                  action="action_safe_pod_config_list"
                  sequence="10"/>
        <menuitem id="menu_delivery_tracking" name="Delivery Tracking"
                  action="action_delivery_tracking_record_list"
                  sequence="20"/>
    </menuitem>

    <!-- Actions -->
    <record id="action_input_vmi_configuration_list" model="ir.actions.act_window">
        <field name="name">VMI Configurations</field>
        <field name="res_model">input.vmi.configuration</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_joint_procurement_config_list" model="ir.actions.act_window">
        <field name="name">Joint Procurement Configurations</field>
        <field name="res_model">joint.procurement.configuration</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_supply_risk_radar_list" model="ir.actions.act_window">
        <field name="name">Supply Risk Radar</field>
        <field name="res_model">supply.risk.radar</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_safe_pod_config_list" model="ir.actions.act_window">
        <field name="name">Safe POD Configurations</field>
        <field name="res_model">safe.pod.configuration</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_delivery_tracking_record_list" model="ir.actions.act_window">
        <field name="name">Delivery Tracking Records</field>
        <field name="res_model">delivery.tracking.record</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>