<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Safe POD Configuration Tree View -->
    <record id="view_safe_pod_configuration_tree" model="ir.ui.view">
        <field name="name">safe.pod.configuration.tree</field>
        <field name="model">safe.pod.configuration</field>
        <field name="arch" type="xml">
            <tree string="Safe POD Configurations">
                <field name="name"/>
                <field name="temperature_monitoring_required"/>
                <field name="requires_photo_confirmation"/>
                <field name="requires_signature_confirmation"/>
                <field name="requires_id_verification"/>
            </tree>
        </field>
    </record>

    <!-- Safe POD Configuration Form View -->
    <record id="view_safe_pod_configuration_form" model="ir.ui.view">
        <field name="name">safe.pod.configuration.form</field>
        <field name="model">safe.pod.configuration</field>
        <field name="arch" type="xml">
            <form string="Safe POD Configuration">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="auto_generate_checklist"/>
                        </group>
                    </group>
                    <group string="Confirmation Requirements">
                        <group>
                            <field name="requires_photo_confirmation"/>
                            <field name="requires_signature_confirmation"/>
                        </group>
                        <group>
                            <field name="requires_id_verification"/>
                            <field name="temperature_monitoring_required"/>
                            <field name="requires_temperature_logs"/>
                        </group>
                    </group>
                    <field name="delivery_checklist_template"/>
                    <field name="checklist_items"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Menu Items for Delivery Tracking -->
    <menuitem id="menu_safe_pod_configurations" name="POD Configurations"
              parent="menu_safe_pod"
              sequence="5">
        <menuitem id="menu_safe_pod_config_list" name="POD Configurations"
                  action="action_safe_pod_configuration_list"
                  sequence="10"/>
    </menuitem>

    <!-- Actions -->
    <record id="action_safe_pod_configuration_list" model="ir.actions.act_window">
        <field name="name">Safe POD Configurations</field>
        <field name="res_model">safe.pod.configuration</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>