<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>
    <record id="action_gov_audit_snapshot" model="ir.actions.act_window">
        <field name="name">Government Audit Snapshots</field>
        <field name="res_model">gov.audit.snapshot</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_gov_audit_snapshot_tree" model="ir.ui.view">
        <field name="name">gov.audit.snapshot.list</field>
        <field name="model">gov.audit.snapshot</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" decoration-info="gov_review_status == 'pending'" decoration-success="gov_review_status == 'verified'">
                <field name="snapshot_ref" />
                <field name="create_date" string="Audit Date" />
                <field name="farm_id" />
                <field name="location_id" />
                <field name="operator_name" />
                <field name="gov_review_status" widget="badge" />
            </list>
        </field>
    </record>

    <record id="view_gov_audit_snapshot_form" model="ir.ui.view">
        <field name="name">gov.audit.snapshot.form</field>
        <field name="model">gov.audit.snapshot</field>
        <field name="arch" type="xml">
            <form create="0" delete="0" edit="0">
                <header>
                    <button name="action_verify_signature" string="Verify Data Integrity" type="object" class="oe_highlight" />
                    <button name="action_push_to_platform" string="Push to Gov Platform" type="object" invisible="is_reported" />
                    <field name="gov_review_status" widget="statusbar" clickable="1" groups="base.group_system" />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_gov_audit_snapshot)d" type="action" class="oe_stat_button" icon="fa-cloud-upload" invisible="not is_reported">
                            <div class="o_stat_info">
                                <span class="o_stat_text text-success">Reported</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="snapshot_ref" />
                        <h1><field name="snapshot_ref" /></h1>
                    </div>
                    <group>
                        <group string="Source Information">
                            <field name="farm_id" />
                            <field name="location_id" />
                            <field name="operator_name" />
                        </group>
                        <group string="Reporting Status">
                            <field name="is_reported" />
                            <field name="report_date" invisible="not is_reported" />
                            <field name="platform_response" invisible="not platform_response" />
                        </group>
                    </group>
                    <group>
                        <group string="System Integrity">
                            <field name="create_date" readonly="1" />
                            <field name="digital_signature" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Raw Evidence Data" name="payload">
                            <field name="snapshot_data" widget="ace" options="{'mode': 'json'}" />
                        </page>
                        <page string="Government Review" name="review" groups="base.group_system">
                            <group>
                                <field name="gov_auditor_id" />
                                <field name="gov_comments" />
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</data>
</odoo>