<?xml version="1.0" encoding="utf-8"?>
<odoo><record id="view_agri_cost_template_tree" model="ir.ui.view">
        <field name="name">agri.cost.template.tree</field>
        <field name="model">agri.cost.template</field>
        <field name="arch" type="xml">
            <list string="Agricultural Cost Templates">
                <field name="name"/>
                <field name="code"/>
                <field name="category"/>
                <field name="unit_type"/>
                <field name="unit_cost"/>
                <field name="is_active"/>
            </list>
        </field>
    </record>

    
    <record id="view_agri_cost_template_form" model="ir.ui.view">
        <field name="name">agri.cost.template.form</field>
        <field name="model">agri.cost.template</field>
        <field name="arch" type="xml">
            <form string="Agricultural Cost Template">
                <header>
                    <field name="is_active" widget="boolean_toggle"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="category"/>
                        </group>
                        <group>
                            <field name="unit_type"/>
                            <field name="unit_cost"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Details" invisible="category not in ['labor', 'machinery', 'fertilizer', 'pesticide']">
                            <group invisible="category != 'labor'">
                                <field name="labor_type"/>
                            </group>
                            <group invisible="category != 'machinery'">
                                <field name="machinery_type"/>
                            </group>
                            <group invisible="category != 'fertilizer'">
                                <field name="fertilizer_type"/>
                            </group>
                            <group invisible="category != 'pesticide'">
                                <field name="pesticide_type"/>
                            </group>
                        </page>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    
    <record id="action_agri_cost_template" model="ir.actions.act_window">
        <field name="name">Agricultural Cost Templates</field>
        <field name="res_model">agri.cost.template</field>
        <field name="view_mode">tree,form</field>
    </record>

    
    <record id="view_agri_cost_calculation_form" model="ir.ui.view">
        <field name="name">agri.cost.calculation.form</field>
        <field name="model">agri.cost.calculation</field>
        <field name="arch" type="xml">
            <form string="Cost Calculation">
                <sheet>
                    <group>
                        <group>
                            <field name="task_id"/>
                            <field name="land_parcel_id"/>
                        </group>
                        <group>
                            <field name="area_value"/>
                            <field name="area_unit"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Cost Lines">
                            <field name="cost_line_ids">
                                <list editable="bottom">
                                    <field name="template_id"/>
                                    <field name="quantity"/>
                                    <field name="unit_cost"/>
                                    <field name="total_cost"/>
                                </list>
                            </field>
                        </page>
                        <page string="Results">
                            <group>
                                <group string="Category Costs">
                                    <field name="total_seedling_cost"/>
                                    <field name="total_fertilizer_cost"/>
                                    <field name="total_pesticide_cost"/>
                                    <field name="total_labor_cost"/>
                                    <field name="total_machinery_cost"/>
                                    <field name="total_irrigation_cost"/>
                                    <field name="total_other_cost"/>
                                </group>
                                <group string="Summary">
                                    <field name="total_cost"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button name="calculate" type="object" string="Calculate" class="oe_highlight"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    
    <record id="action_agri_cost_calculation" model="ir.actions.act_window">
        <field name="name">Cost Calculator</field>
        <field name="res_model">agri.cost.calculation</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record></odoo>