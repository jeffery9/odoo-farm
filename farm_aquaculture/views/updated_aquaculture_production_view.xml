<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Updated ISL View for Aquaculture Production to include new Odoo 19 features -->
    <record id="view_farm_aquaculture_production_form_updated" model="ir.ui.view">
        <field name="name">farm.aquaculture.production.form.updated</field>
        <field name="model">farm.aquaculture.production</field>
        <field name="priority" eval="100"/>
        <field name="arch" type="xml">
            <form string="Aquaculture Growth Order">
                <header>
                    <button name="action_confirm" type="object" string="Confirm" invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="button_mark_done" type="object" string="Mark as Done" invisible="state != 'confirmed'" class="oe_highlight"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>Aquaculture Order</h1>
                    </div>
                    <group>
                        <group string="Order Info (Base)">
                            <field name="product_id"/>
                            <field name="product_qty"/>
                            <field name="bom_id"/>
                            <field name="date_start"/>
                        </group>
                        <group string="Water Quality (ISL)">
                            <field name="water_temp"/>
                            <field name="dissolved_oxygen"/>
                            <field name="ph_level"/>
                        </group>
                    </group>
                    <group>
                        <group string="Growth Stats (ISL)">
                            <field name="avg_individual_weight"/>
                            <field name="survival_rate"/>
                        </group>
                        <group string="Security &amp; Performance">
                            <field name="security_level"/>
                            <field name="current_density"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Configuration">
                            <field name="aquaculture_config" widget="ace" options="{'mode': 'json'}"/>
                        </page>
                        <page string="Performance Monitor">
                            <group>
                                <field name="performance_monitor_ids" nolabel="1" colspan="2">
                                    <list string="Performance Monitors">
                                        <field name="name"/>
                                        <field name="duration"/>
                                        <field name="record_count"/>
                                        <field name="start_time"/>
                                        <field name="status"/>
                                    </list>
                                </field>
                            </group>
                        </page>
                    </notebook></sheet></form>
                </sheet>
            </form>
        </field>
    </record>