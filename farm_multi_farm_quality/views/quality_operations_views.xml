        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_internal_marketplace_list" model="ir.actions.act_window">
        <field name="name">Internal Marketplace</field>
        <field name="res_model">internal.marketplace</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_procurement_planning_list" model="ir.actions.act_window">
        <field name="name">Procurement Planning</field>
        <field name="res_model">procurement.planning</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_agri_service_list" model="ir.actions.act_window">
        <field name="name">Agricultural Services</field>
        <field name="res_model">agri.service</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_service_order_list" model="ir.actions.act_window">
        <field name="name">Service Orders</field>
        <field name="res_model">service.order</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_internal_loan_list" model="ir.actions.act_window">
        <field name="name">Internal Loans</field>
        <field name="res_model">internal.loan</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_subsidy_disbursement_list" model="ir.actions.act_window">
        <field name="name">Subsidy Disbursements</field>
        <field name="res_model">subsidy.disbursement</field>
        <field name="view_mode">tree,form</field>
