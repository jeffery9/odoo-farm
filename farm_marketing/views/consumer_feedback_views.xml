<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_farm_consumer_feedback_tree" model="ir.ui.view">
        <field name="name">farm.consumer.feedback.list</field>
        <field name="model">farm.consumer.feedback</field>
        <field name="arch" type="xml">
            <list create="false">
                <field name="create_date" string="Feedback Date"/>
                <field name="lot_id"/>
                <field name="product_id"/>
                <field name="rating" widget="priority"/>
                <field name="taste_score"/>
                <field name="freshness_score"/>
                <field name="consumer_region"/>
                <field name="comment"/>
            </list>
        </field>
    </record>

    <record id="view_farm_consumer_feedback_pivot" model="ir.ui.view">
        <field name="name">farm.consumer.feedback.pivot</field>
        <field name="model">farm.consumer.feedback</field>
        <field name="arch" type="xml">
            <pivot string="C2M Sentiment Analysis">
                <field name="product_id" type="row"/>
                <field name="rating" type="col"/>
                <field name="taste_score" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_farm_consumer_feedback" model="ir.actions.act_window">
        <field name="name">C2M Consumer Feedback</field>
        <field name="res_model">farm.consumer.feedback</field>
        <field name="view_mode">list,pivot,form</field>
    </record>

    <menuitem id="menu_consumer_feedback" name="Consumer Insights (C2M)" 
              parent="farm_core.menu_marketing_root" action="action_farm_consumer_feedback" sequence="50"/>
</odoo>
