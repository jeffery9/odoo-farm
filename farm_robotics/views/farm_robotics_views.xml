<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Farm Robot Views -->
    <record id="view_farm_robot_tree" model="ir.ui.view">
        <name>farm.robot.list</name>
        <model>farm.robot</model>
        <arch type="xml">
            <list decoration-success="robot_status == 'working'" decoration-warning="robot_status == 'charging'" decoration-danger="robot_status == 'error'">
                <field name="name"/>
                <field name="robot_type"/>
                <field name="robot_status" widget="badge"/>
                <field name="battery_level" widget="progressbar"/>
                <field name="current_mission_id"/>
            </list>
        </arch>
    </record>

    <record id="view_farm_robot_form" model="ir.ui.view">
        <name>farm.robot.form</name>
        <model>farm.robot</model>
        <arch type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="robot_type"/>
                            <field name="device_id"/>
                        </group>
                        <group>
                            <field name="robot_status" widget="badge"/>
                            <field name="battery_level" widget="gauge" options="{'max_field': 100}"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </arch>
    </record>

    <record id="action_farm_robot" model="ir.actions.act_window">
        <name>Robots Registry</name>
        <res_model>farm.robot</res_model>
        <view_mode>list,form,kanban</view_mode>
    </record>

    <!-- Mission Views -->
    <record id="view_farm_robot_mission_tree" model="ir.ui.view">
        <name>farm.robot.mission.list</name>
        <model>farm.robot.mission</model>
        <arch type="xml">
            <list decoration-info="state == 'scheduled'" decoration-success="state == 'completed'">
                <field name="name"/>
                <field name="robot_id"/>
                <field name="location_id"/>
                <field name="progress" widget="progressbar"/>
                <field name="state" widget="badge"/>
            </list>
        </arch>
    </record>

    <record id="view_farm_robot_mission_form" model="ir.ui.view">
        <name>farm.robot.mission.form</name>
        <model>farm.robot.mission</model>
        <arch type="xml">
            <form>
                <header>
                    <button name="action_start_mission" string="Start Mission" type="object" class="oe_highlight" invisible="state != 'scheduled'"/>
                    <button name="action_emergency_stop" string="Emergency Stop" type="object" class="btn-danger" invisible="state != 'in_progress'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,scheduled,in_progress,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="robot_id"/>
                            <field name="task_id"/>
                        </group>
                        <group>
                            <field name="location_id"/>
                            <field name="progress" widget="progressbar"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Path Data" name="path">
                            <field name="planned_path_geojson" widget="ace" options="{'mode': 'json'}" placeholder="Enter Planned Path GeoJSON..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </arch>
    </record>

    <record id="action_farm_robot_mission" model="ir.actions.act_window">
        <name>Robot Missions</name>
        <res_model>farm.robot.mission</res_model>
        <view_mode>list,form</view_mode>
    </record>

    <!-- Menus -->
    <menuitem id="menu_farm_robotics_root" name="Robotics &amp; Automation" 
              parent="farm_core.menu_farm_root" sequence="45"/>
    
    <menuitem id="menu_farm_robot_registry" name="Robot Fleet" 
              parent="menu_farm_robotics_root" action="action_farm_robot" sequence="10"/>
              
    <menuitem id="menu_farm_robot_mission" name="Mission Control" 
              parent="menu_farm_robotics_root" action="action_farm_robot_mission" sequence="20"/>
</odoo>
