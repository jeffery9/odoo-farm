<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_robotics_lease_expiry_check" model="ir.cron">
            <field name="name">Robotics Lease Expiry Checker Scheduler</field>
            <field name="model_id" ref="model_agri_robotics_lease"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_expired_leases()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>