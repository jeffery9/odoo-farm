<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record id="view_agri_biodiversity_indicator_list" model="ir.ui.view">
        <field name="name">agri.sustainability.biodiversity.indicator.list</field>
        <field name="model">agri.sustainability.biodiversity.indicator</field>
        <field name="arch" type="xml">
            <list string="Biodiversity Observations" decoration-info="indicator_type == 'insect'" decoration-success="indicator_type == 'soil_life'">
                <field name="date"/>
                <field name="location_id"/>
                <field name="indicator_type"/>
                <field name="species_name"/>
                <field name="count_observed"/>
                <field name="esg_score" optional="show"/>
            </list>
        </field>
    </record>

    
    <record id="view_agri_biodiversity_indicator_form" model="ir.ui.view">
        <field name="name">agri.sustainability.biodiversity.indicator.form</field>
        <field name="model">agri.sustainability.biodiversity.indicator</field>
        <field name="arch" type="xml">
            <form string="Biodiversity Observation">
                <header>
                    <button name="action_verify_observation" type="object" string="Audit Evidence" class="oe_highlight"/>
                    <field name="audit_status" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="species_name" class="oe_edit_only" string="Observed Species"/>
                        <h1><field name="species_name" placeholder="e.g. Honeybee (Apis mellifera)"/></h1>
                    </div>
                    <group>
                        <group string="Observation Metadata">
                            <field name="date"/>
                            <field name="location_id"/>
                            <field name="indicator_type"/>
                            <field name="count_observed"/>
                        </group>
                        <group string="Impact &amp; Integrity (L2)">
                            <field name="esg_score"/>
                            <field name="audit_confidence" widget="progressbar"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Visual Evidence" name="evidence">
                            <field name="photo" widget="image" class="oe_avatar"/>
                            <field name="notes" placeholder="Describe the habitat conditions..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter>
                    <message/>
                    <activity/>
                </chatter>
            </form>
        </field>
    </record>

    
    <record id="view_agri_ecological_zone_list" model="ir.ui.view">
        <field name="name">agri.sustainability.ecological.zone.list</field>
        <field name="model">agri.sustainability.ecological.zone</field>
        <field name="arch" type="xml">
            <list string="Ecological Infrastructure" editable="bottom">
                <field name="name"/>
                <field name="zone_type"/>
                <field name="area"/>
                <field name="location_id"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    
    <record id="action_agri_biodiversity" model="ir.actions.act_window">
        <field name="name">Biodiversity Observations</field>
        <field name="res_model">agri.sustainability.biodiversity.indicator</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_agri_ecological_zone" model="ir.actions.act_window">
        <field name="name">Ecological Infrastructure</field>
        <field name="res_model">agri.sustainability.ecological.zone</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_agri_ecology_root" name="Ecology &amp; Nature" 
 web_icon="farm_ecology,static/description/icon.png" sequence="60"/>
    
    <menuitem id="menu_agri_biodiversity" name="Biodiversity Logs" 
              parent="menu_agri_ecology_root" action="action_agri_biodiversity" sequence="10"/>
              
    <menuitem id="menu_agri_ecological_zone" name="Ecological Zones" 
              parent="menu_agri_ecology_root" action="action_agri_ecological_zone" sequence="20"/>
</odoo>