<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>
    <record id="view_farm_agritourism_operation_tree" model="ir.ui.view">
        <field name="name">farm.agritourism.operation.list</field>
        <field name="model">farm.agritourism.operation</field>
        <field name="arch" type="xml">
            <list string="Agritourism Activities">
                <field name="name"/>
                <field name="activity_type"/>
                <field name="partner_id"/>
                <field name="stage_id"/>
            </list>
        </field>
    </record>

    <record id="view_farm_agritourism_operation_form" model="ir.ui.view">
        <field name="name">farm.agritourism.operation.form</field>
        <field name="model">farm.agritourism.operation</field>
        <field name="arch" type="xml">
            <form string="Agritourism Activity">
                <header>
                    <field name="stage_id" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Activity Title..."/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="activity_type"/>
                            <field name="partner_id"/>
                            <field name="project_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="date_deadline"/>
                            <field name="user_ids" widget="many2many_avatar_user"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Experience Details" name="experience">
                            <group>
                                <field name="description"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <menuitem id="menu_farm_agritourism_operations"
              name="Operations"
              parent="menu_farm_agritourism_root"
              action="action_farm_agritourism_operations"
              sequence="15"/>
</data>
</odoo>
