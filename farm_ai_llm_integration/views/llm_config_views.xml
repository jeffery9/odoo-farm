<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>
<record id="view_llm_config_tree" model="ir.ui.view">
        <field name="name">agri.ai.llm.configuration.tree</field>
        <field name="model">agri.ai.llm.configuration</field>
        <field name="arch" type="xml">
            <list string="LLM Configurations">
                <field name="name" />
                <field name="provider" />
                <field name="default_model" />
                <field name="is_active" />
                <field name="is_default" />
                <field name="application_type" />
                <field name="create_date" />
            </list>
        </field>
    </record>

    
    <record id="view_llm_config_form" model="ir.ui.view">
        <field name="name">agri.ai.llm.configuration.form</field>
        <field name="model">agri.ai.llm.configuration</field>
        <field name="arch" type="xml">
            <form string="LLM Configuration">
                <header>
                    <field name="is_active" widget="boolean_toggle" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Configuration Name" />
                        </h1>
                    </div>
                    <group>
                        <group string="Provider Settings">
                            <field name="provider" />
                            <field name="api_key" password="True" />
                            <field name="base_url" placeholder="Leave empty for default URL" />
                            <field name="default_model" placeholder="e.g., gpt-4, claude-3-opus, gemini-pro" />
                        </group>
                        <group string="Model Parameters">
                            <field name="temperature" />
                            <field name="max_tokens" />
                            <field name="timeout" />
                        </group>
                    </group>
                    <group string="Performance Settings">
                        <group>
                            <field name="rate_limit_requests" />
                            <field name="rate_limit_period" />
                        </group>
                        <group>
                            <field name="is_default" />
                            <field name="application_type" />
                            <field name="use_agricultural_context" />
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" />
                    <field name="activity_ids" />
                    <field name="message_ids" />
                </div>
            </form>
        </field>
    </record>

    
    <record id="action_llm_config" model="ir.actions.act_window">
        <field name="name">LLM Configurations</field>
        <field name="res_model">agri.ai.llm.configuration</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configure your LLM provider settings!
            </p>
            <p>
                Set up connections to Large Language Models like OpenAI GPT, Anthropic Claude,
                Google Gemini, Hugging Face models, or local Ollama instances. Configure API keys,
                models, and agricultural domain settings for optimal performance.
            </p>
        </field>
    </record>
</data>
</odoo>