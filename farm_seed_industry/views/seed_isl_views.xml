<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record id="view_farm_seed_batch_form" model="ir.ui.view">
        <field name="name">farm.seed.batch.form</field>
        <field name="model">farm.seed.batch</field>
        <field name="arch" type="xml">
            <form string="Seed Batch Details">
                <header>
                    <button name="action_verify_seed_quality" string="Verify Quality" type="object" class="oe_highlight"/>
                    <field name="is_pvp_compliant" invisible="1"/>
                    <widget name="web_ribbon" title="PVP Compliant" bg_color="bg-success" invisible="not is_pvp_compliant"/>
                    <widget name="web_ribbon" title="PVP Expired" bg_color="bg-danger" invisible="is_pvp_compliant"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="lot_id" string="Batch ID"/>
                        <h1><field name="lot_id" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Four-Testing Metrics (种子四检)">
                            <field name="germination_rate" widget="gauge" options="{'max_field': '100'}"/>
                            <field name="purity_rate"/>
                            <field name="clarity_rate"/>
                            <field name="moisture_content"/>
                        </group>
                        <group string="Lineage &amp; Compliance">
                            <field name="parent_p1_hash" string="P1 (Sire) DNA"/>
                            <field name="parent_p2_hash" string="P2 (Dam) DNA"/>
                            <field name="pvp_certificate_id"/>
                            <field name="thousand_seed_weight"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Traceability Fingerprint">
                            <field name="traceability_hash" widget="text" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    
    <record id="view_farm_seed_production_form" model="ir.ui.view">
        <field name="name">farm.seed.production.form</field>
        <field name="model">farm.seed.production</field>
        <field name="arch" type="xml">
            <form string="Seed propagation Order">
                <header>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Target Variety">
                            <field name="product_id" string="Target Seed"/>
                            <field name="bom_id" string="Variety Recipe"/>
                            <field name="product_qty" string="Expected Quantity"/>
                        </group>
                        <group string="Nursery Context">
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    
    <record id="action_farm_seed_batch" model="ir.actions.act_window">
        <field name="name">Seed Batches</field>
        <field name="res_model">farm.seed.batch</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_farm_seed_production" model="ir.actions.act_window">
        <field name="name">Propagation Orders</field>
        <field name="res_model">farm.seed.production</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>