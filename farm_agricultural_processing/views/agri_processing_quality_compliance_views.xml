<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Mass Balance Production Extension Form Inherit View -->
    <record id="view_farm_processing_production_mass_balance_inherit" model="ir.ui.view">
        <field name="name">agri.isl.processing.production.mass.balance.inherit</field>
        <field name="model">agri.isl.processing.production</field>
        <field name="inherit_id" ref="farm_processing.view_farm_processing_production_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='agri_processing']//group[@name='mass_energy']" position="inside">
                <field name="total_input_qty"/>
                <field name="total_output_qty"/>
                <field name="total_loss_qty"/>
                <field name="theoretical_output_qty"/>
                <field name="balance_variance"/>
                <field name="variance_percentage"/>
                <field name="max_variance_tolerance"/>
                <field name="is_balanced"/>
                <field name="compliance_status"/>
            </xpath>
        </field>
    </record>

    <!-- Multi-Output Processing Tree View -->
    <record id="view_agri_processing_multi_output_tree" model="ir.ui.view">
        <field name="name">agri.processing.multi.output.tree</field>
        <field name="model">agri.processing.multi.output</field>
        <field name="arch" type="xml">
            <list string="Multi-Output Process">
                <field name="name"/>
                <field name="bom_id"/>
                <field name="input_qty"/>
                <field name="total_output_qty"/>
                <field name="yield_rate"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Multi-Output Processing Form View -->
    <record id="view_agri_processing_multi_output_form" model="ir.ui.view">
        <field name="name">agri.processing.multi.output.form</field>
        <field name="model">agri.processing.multi.output</field>
        <field name="arch" type="xml">
            <form string="Multi-Output Processing">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="bom_id"/>
                            <field name="production_id"/>
                        </group>
                        <group>
                            <field name="input_qty"/>
                            <field name="total_output_qty"/>
                            <field name="yield_rate"/>
                        </group>
                    </group>
                    <group string="Output Products">
                        <field name="output_line_ids">
                            <list editable="top">
                                <field name="product_id"/>
                                <field name="output_qty"/>
                                <field name="output_percentage"/>
                                <field name="component_ratio"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Attribute Inheritance Tree View -->
    <record id="view_agri_processing_attribute_inheritance_tree" model="ir.ui.view">
        <field name="name">agri.processing.attribute.inheritance.tree</field>
        <field name="model">agri.processing.attribute.inheritance</field>
        <field name="arch" type="xml">
            <list string="Attribute Inheritance Rules">
                <field name="name"/>
                <field name="source_product_id"/>
                <field name="target_product_id"/>
                <field name="inherits_organic"/>
                <field name="processing_method"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Attribute Inheritance Form View -->
    <record id="view_agri_processing_attribute_inheritance_form" model="ir.ui.view">
        <field name="name">agri.processing.attribute.inheritance.form</field>
        <field name="model">agri.processing.attribute.inheritance</field>
        <field name="arch" type="xml">
            <form string="Attribute Inheritance Rule">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="source_product_id"/>
                        </group>
                        <group>
                            <field name="target_product_id"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Inherited Attributes">
                        <field name="inherits_organic"/>
                        <field name="inherits_biodynamic"/>
                        <field name="inherits_geo_origin"/>
                        <field name="inherits_harvest_date"/>
                    </group>
                    <group string="Processing Additions">
                        <field name="processing_method"/>
                        <field name="special_features"/>
                    </group>
                    <group string="Attribute JSON Data">
                        <field name="inherited_attributes" widget="text"/>
                        <field name="incremental_attributes" widget="text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Active Ingredient Standardization Tree View -->
    <record id="view_agri_processing_active_ingredient_tree" model="ir.ui.view">
        <field name="name">agri.processing.active.ingredient.tree</field>
        <field name="model">agri.processing.active.ingredient</field>
        <field name="arch" type="xml">
            <list string="Active Ingredient Standardization">
                <field name="name"/>
                <field name="ai_name"/>
                <field name="product_tmpl_id"/>
                <field name="target_ai_content"/>
                <field name="actual_ai_content"/>
                <field name="is_content_valid"/>
            </list>
        </field>
    </record>

    <!-- Active Ingredient Standardization Form View -->
    <record id="view_agri_processing_active_ingredient_form" model="ir.ui.view">
        <field name="name">agri.processing.active.ingredient.form</field>
        <field name="model">agri.processing.active.ingredient</field>
        <field name="arch" type="xml">
            <form string="Active Ingredient Standardization">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="product_tmpl_id"/>
                        </group>
                        <group>
                            <field name="ai_name"/>
                            <field name="ai_measurement_unit"/>
                        </group>
                    </group>
                    <group string="Target Content">
                        <field name="target_ai_content"/>
                        <field name="actual_ai_content"/>
                        <field name="is_content_valid"/>
                    </group>
                    <group string="Content Limits">
                        <field name="min_ai_content"/>
                        <field name="max_ai_content"/>
                    </group>
                    <group string="Adjustment Calculations">
                        <field name="adjustment_factor"/>
                        <field name="adjusted_dosage"/>
                    </group>
                    <field name="notes"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Allergen Control Tree View -->
    <record id="view_agri_processing_allergen_control_tree" model="ir.ui.view">
        <field name="name">agri.processing.allergen.control.tree</field>
        <field name="model">agri.processing.allergen.control</field>
        <field name="arch" type="xml">
            <list string="Allergen Control Records"
                  decoration-info="cleaning_required"
                  decoration-success="cleaning_performed"
                  decoration-warning="allergen_conflict_detected">
                <field name="name"/>
                <field name="production_id"/>
                <field name="workcenter_id"/>
                <field name="allergen_conflict_detected"/>
                <field name="cleaning_required"/>
                <field name="cleaning_performed"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Allergen Control Form View -->
    <record id="view_agri_processing_allergen_control_form" model="ir.ui.view">
        <field name="name">agri.processing.allergen.control.form</field>
        <field name="model">agri.processing.allergen.control</field>
        <field name="arch" type="xml">
            <form string="Allergen Control and Cleaning">
                <header>
                    <field name="state" widget="statusbar"/>
                    <button name="action_execute_recall_simulation" type="object" string="Start Cleaning Verification"
                            class="oe_highlight" invisible="state != 'cleaning_required'"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="production_id"/>
                        </group>
                        <group>
                            <field name="workcenter_id"/>
                            <field name="allergen_conflict_detected"/>
                            <field name="cleaning_required"/>
                        </group>
                    </group>
                    <group string="Allergen Information">
                        <field name="contains_allergens"/>
                        <field name="allergen_details"/>
                        <field name="all_allergens"/>
                    </group>
                    <group string="Previous Equipment Information">
                        <field name="previous_allergens"/>
                    </group>
                    <group string="Cleaning Execution" invisible="not cleaning_required">
                        <field name="cleaning_performed"/>
                        <field name="cleaning_by"/>
                        <field name="cleaning_date"/>
                        <field name="cleaning_verification_by"/>
                        <field name="cleaning_verification_date"/>
                    </group>
                    <field name="cleaning_procedure"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- GMP Monitoring Tree View -->
    <record id="view_agri_processing_gmp_monitoring_tree" model="ir.ui.view">
        <field name="name">agri.processing.gmp.monitoring.tree</field>
        <field name="model">agri.processing.gmp.monitoring</field>
        <field name="arch" type="xml">
            <list string="GMP Environmental Monitoring">
                <field name="name"/>
                <field name="production_id"/>
                <field name="monitoring_date"/>
                <field name="temperature_avg"/>
                <field name="humidity_avg"/>
                <field name="is_environment_compliant"/>
                <field name="recorded_by"/>
            </list>
        </field>
    </record>

    <!-- GMP Monitoring Form View -->
    <record id="view_agri_processing_gmp_monitoring_form" model="ir.ui.view">
        <field name="name">agri.processing.gmp.monitoring.form</field>
        <field name="model">agri.processing.gmp.monitoring</field>
        <field name="arch" type="xml">
            <form string="GMP Environmental Monitoring">
                <header>
                    <field name="validated_by"/>
                    <field name="validation_date"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="production_id"/>
                            <field name="monitoring_date"/>
                        </group>
                        <group>
                            <field name="recorded_by"/>
                            <field name="is_environment_compliant"/>
                        </group>
                    </group>
                    <group string="Temperature Monitoring">
                        <field name="temperature_min"/>
                        <field name="temperature_max"/>
                        <field name="temperature_avg"/>
                    </group>
                    <group string="Humidity Monitoring">
                        <field name="humidity_min"/>
                        <field name="humidity_max"/>
                        <field name="humidity_avg"/>
                    </group>
                    <group string="Air Quality">
                        <field name="air_pressure_diff"/>
                        <field name="particle_count_05um"/>
                        <field name="particle_count_5um"/>
                    </group>
                    <field name="environmental_alerts"/>
                    <field name="bmr_content" widget="text"/>
                    <field name="notes"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Label Compliance Tree View -->
    <record id="view_agri_processing_label_compliance_tree" model="ir.ui.view">
        <field name="name">agri.processing.label.compliance.tree</field>
        <field name="model">agri.processing.label.compliance</field>
        <field name="arch" type="xml">
            <list string="Label Compliance Records">
                <field name="name"/>
                <field name="product_id"/>
                <field name="is_approved"/>
                <field name="is_license_compliant"/>
                <field name="export_compliant"/>
                <field name="reviewed_date"/>
            </list>
        </field>
    </record>

    <!-- Label Compliance Form View -->
    <record id="view_agri_processing_label_compliance_form" model="ir.ui.view">
        <field name="name">agri.processing.label.compliance.form</field>
        <field name="model">agri.processing.label.compliance</field>
        <field name="arch" type="xml">
            <form string="Label Compliance and Nutrition Labeling">
                <header>
                    <field name="is_approved" widget="boolean_toggle"/>
                    <field name="reviewed_by"/>
                    <field name="reviewed_date"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="product_id"/>
                            <field name="production_batch_id"/>
                        </group>
                        <group>
                            <field name="is_approved"/>
                            <field name="export_compliant"/>
                        </group>
                    </group>
                    <group string="SC License Compliance">
                        <field name="sc_license_required"/>
                        <field name="sc_license_number"/>
                        <field name="is_license_compliant"/>
                    </group>
                    <group string="Nutrition Information">
                        <field name="allergen_warning_required"/>
                        <field name="health_claim_approved"/>
                    </group>
                    <group string="Generated Content">
                        <field name="generated_label_content" widget="text"/>
                        <field name="label_template_id"/>
                    </group>
                    <notebook>
                        <page string="Nutrition Composition" name="nutrition">
                            <field name="nutrition_composition" widget="text"/>
                        </page>
                        <page string="Warnings &amp; Claims" name="warnings">
                            <group string="Allergen Warnings">
                                <field name="allergen_warnings" widget="text"/>
                            </group>
                            <group string="Health Claims">
                                <field name="health_claims_text" widget="text"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

</odoo>