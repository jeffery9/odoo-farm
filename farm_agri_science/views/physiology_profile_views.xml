<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_agri_physiology_profile_tree" model="ir.ui.view">
        <field name="name">agri.physiology.profile.tree</field>
        <field name="model">agri.physiology.profile</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="temp_base"/>
                <field name="temp_opt"/>
                <field name="temp_max"/>
            </list>
        </field>
    </record>

    <record id="view_agri_physiology_profile_form" model="ir.ui.view">
        <field name="name">agri.physiology.profile.form</field>
        <field name="model">agri.physiology.profile</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Variety Physiology Fingerprint..."/></h1>
                    </div>
                    <group>
                        <group string="Cardinal Temperatures">
                            <field name="temp_base"/>
                            <field name="temp_opt"/>
                            <field name="temp_max"/>
                        </group>
                        <group string="Growth Curve Parameters">
                            <field name="logistic_l"/>
                            <field name="logistic_k"/>
                            <field name="logistic_gdd0"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Growth Stages" name="stages">
                            <field name="stage_ids">
                                <list editable="bottom">
                                    <field name="stage_code"/>
                                    <field name="name"/>
                                    <field name="gdd_threshold"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_agri_physiology_profile" model="ir.actions.act_window">
        <field name="name">Physiology Profiles</field>
        <field name="res_model">agri.physiology.profile</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_agri_science_root" name="Agri-Science" web_icon="farm_agri_science,static/description/icon.png" sequence="15"/>
    <menuitem id="menu_agri_physiology_profile" name="Physiology Profiles" parent="menu_agri_science_root" action="action_agri_physiology_profile" sequence="10"/>
</odoo>
