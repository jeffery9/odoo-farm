<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_agri_vra_strategy_list" model="ir.ui.view">
        <field name="name">agri.intervention.vra.strategy.list</field>
        <field name="model">agri.intervention.vra.strategy</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="type"/>
                <field name="is_stage_aware"/>
                <field name="is_kinetics_aware"/>
                <field name="is_cultivar_aware"/>
            </list>
        </field>
    </record>

    <record id="view_agri_vra_strategy_form" model="ir.ui.view">
        <field name="name">agri.intervention.vra.strategy.form</field>
        <field name="model">agri.intervention.vra.strategy</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Strategy Name..."/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="type"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Logic Parameters" name="logic_params">
                            <group string="Linear Parameters" invisible="type != 'inverse_ndvi'">
                                <group>
                                    <field name="target_ndvi"/>
                                    <field name="correction_slope"/>
                                </group>
                            </group>
                            <group string="Step Parameters" invisible="type != 'fixed_step'">
                                <group>
                                    <field name="low_threshold"/>
                                    <field name="low_multiplier"/>
                                </group>
                                <group>
                                    <field name="high_threshold"/>
                                    <field name="high_multiplier"/>
                                </group>
                            </group>
                            <group string="Biomass Deficit Parameters" invisible="type != 'biomass_deficit'">
                                <group>
                                    <field name="deficit_sensitivity"/>
                                </group>
                            </group>
                        </page>
                        <page string="Scientific Enhancements" name="science_enhancements">
                            <group>
                                <group string="Physiological Factors">
                                    <field name="is_stage_aware"/>
                                    <field name="is_cultivar_aware"/>
                                </group>
                                <group string="Environmental Factors">
                                    <field name="is_kinetics_aware"/>
                                </group>
                            </group>
                            <separator string="Growth-Stage Sensitivity Weights" invisible="not is_stage_aware"/>
                            <field name="stage_rule_ids" invisible="not is_stage_aware">
                                <list editable="bottom">
                                    <field name="stage_id"/>
                                    <field name="intensity_multiplier"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_farm_vra_strategy" model="ir.actions.act_window">
        <field name="name">VRA Strategies</field>
        <field name="res_model">agri.intervention.vra.strategy</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>