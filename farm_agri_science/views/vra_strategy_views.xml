<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_farm_vra_strategy_tree" model="ir.ui.view">
        <name>farm.vra.strategy.list</name>
        <model>farm.vra.strategy</model>
        <arch type="xml">
            <list>
                <field name="name"/>
                <field name="type"/>
            </list>
        </arch>
    </record>

    <record id="view_farm_vra_strategy_form" model="ir.ui.view">
        <name>farm.vra.strategy.form</name>
        <model>farm.vra.strategy</model>
        <arch type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Strategy Name..."/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="type"/>
                        </group>
                    </group>
                    <group string="Linear Parameters" invisible="type != 'inverse_ndvi'">
                        <group>
                            <field name="target_ndvi"/>
                            <field name="correction_slope"/>
                        </group>
                    </group>
                    <group string="Step Parameters" invisible="type != 'fixed_step'">
                        <group>
                            <field name="low_threshold"/>
                            <field name="low_multiplier"/>
                        </group>
                        <group>
                            <field name="high_threshold"/>
                            <field name="high_multiplier"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </arch>
    </record>

    <record id="action_farm_vra_strategy" model="ir.actions.act_window">
        <name>VRA Strategies</name>
        <res_model>farm.vra.strategy</res_model>
        <view_mode>list,form</view_mode>
    </record>
</odoo>
