<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_farm_vra_prescription" model="ir.sequence">
        <name>VRA Prescription</name>
        <field name="code">farm.vra.prescription</field>
        <field name="prefix">VRA/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_farm_biological_twin" model="ir.sequence">
        <name>Biological Twin</name>
        <field name="code">farm.biological.twin</field>
        <field name="prefix">TWIN/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
