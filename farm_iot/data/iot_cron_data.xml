<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_iot_wal_sync_pipeline" model="ir.cron">
            <field name="name">Agri-IoT Asynchronous Telemetry WAL Sync Pipeline (异步对齐管道)</field>
            <field name="model_id" ref="model_agri_iot_wal_log"/>
            <field name="state">code</field>
            <field name="code">model.action_process_pending_wal()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
