<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>
<record id="view_farm_digital_twin_scene_tree" model="ir.ui.view">
        <field name="name">farm.digital.twin.scene.list</field>
        <field name="model">agri.digital.twin.scene</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="location_id" />
                <field name="state" widget="badge" />
            </list>
        </field>
    </record>

    <record id="view_farm_digital_twin_scene_form" model="ir.ui.view">
        <field name="name">farm.digital.twin.scene.form</field>
        <field name="model">agri.digital.twin.scene</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" /></h1>
                    </div>
                    <group>
                        <group>
                            <field name="location_id" />
                            <field name="base_model_url" placeholder="https://example.com/models/farm.glb" />
                        </group>
                        <group>
                            <field name="environment_hdr_url" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Device Markers" name="markers">
                            <field name="device_marker_ids">
                                <list editable="bottom">
                                    <field name="device_id" />
                                    <field name="pos_x" />
                                    <field name="pos_y" />
                                    <field name="pos_z" />
                                    <field name="rotation_y" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="action_farm_digital_twin_scene" model="ir.actions.act_window">
        <field name="name">Digital Twin Scenes</field>
        <field name="res_model">agri.digital.twin.scene</field>
        <field name="view_mode">list,form</field>
    </record>

    
    <record id="view_farm_location_form_digital_twin" model="ir.ui.view">
        <field name="name">farm.location.form.digital.twin</field>
        <field name="model">farm.location</field>
        <field name="inherit_id" ref="farm_core.view_farm_location_form" />
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
<header>

                
            
</header>
</xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Digital Twin Config" name="digital_twin">
                    <group>
                        <group>
                            <field name="isa95_level" />
                            <field name="digital_twin_enabled" />
                            <field name="digital_twin_scene_id" invisible="not digital_twin_enabled" />
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    
    <menuitem id="menu_farm_iot_digital_twin" name="Digital Twin" parent="menu_farm_iot_root" sequence="50" />
    <menuitem id="menu_farm_digital_twin_scene" name="3D Scenes" parent="menu_farm_iot_digital_twin" action="action_farm_digital_twin_scene" sequence="10" />
</data>
</odoo>