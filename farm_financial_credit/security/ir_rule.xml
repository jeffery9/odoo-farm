<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- 3. Micro-Credit Loan Rules -->
        <record id="rule_micro_loan_worker_own" model="ir.rule">
            <field name="name">Worker: See Own Micro-Loans Only</field>
            <field name="model_id" ref="model_farm_micro_loan"/>
            <field name="domain_force">[('farmer_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('farm_core.group_farm_worker'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="1"/> <!-- They can apply for a loan -->
            <field name="perm_unlink" eval="0"/>
        </record>

        <record id="rule_micro_loan_manager_all" model="ir.rule">
            <field name="name">Manager: See All Micro-Loans</field>
            <field name="model_id" ref="model_farm_micro_loan"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('farm_core.group_farm_manager'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>
    
        <record id="rule_micro_loan_owner_hierarchy" model="ir.rule">
            <field name="name">Farm Owner: See Own and Subordinate Micro-Loans</field>
            <field name="model_id" ref="model_farm_micro_loan"/>
            <field name="domain_force">['|', ('farmer_id', '=', user.id), ('farmer_id.partner_id.parent_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('farm_core.group_farm_specialist'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="0"/>
        </record>
    </data>
</odoo>
