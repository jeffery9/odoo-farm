<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree view for credit scores -->
    <record id="view_farm_credit_score_tree" model="ir.ui.view">
        <field name="name">farm.credit.score.tree</field>
        <field name="model">farm.credit.score</field>
        <field name="arch" type="xml">
            <list string="Credit Scores">
                <field name="partner_id"/>
                <field name="evaluation_date"/>
                <field name="total_score"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Form view for credit scores -->
    <record id="view_farm_credit_score_form" model="ir.ui.view">
        <field name="name">farm.credit.score.form</field>
        <field name="model">farm.credit.score</field>
        <field name="arch" type="xml">
            <form string="Credit Score">
                <header>
                    <button name="action_auto_evaluate" type="object" string="Auto Evaluate" class="oe_highlight"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="evaluation_date"/>
                        </group>
                        <group>
                            <field name="total_score"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Components">
                            <group>
                                <group string="Performance Metrics">
                                    <field name="gap_compliance_rate"/>
                                    <field name="yield_consistency_rate"/>
                                </group>
                                <group string="Efficiency Metrics">
                                    <field name="input_reduction_rate"/>
                                    <field name="avg_trust_score"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tree view for settlements -->
    <record id="view_farm_coop_settlement_tree" model="ir.ui.view">
        <field name="name">farm.coop.settlement.tree</field>
        <field name="model">farm.coop.settlement</field>
        <field name="arch" type="xml">
            <list string="Cooperative Settlements">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="date"/>
                <field name="input_debt_amount"/>
                <field name="harvest_credit_amount"/>
                <field name="net_settlement_amount"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Form view for settlements -->
    <record id="view_farm_coop_settlement_form" model="ir.ui.view">
        <field name="name">farm.coop.settlement.form</field>
        <field name="model">farm.coop.settlement</field>
        <field name="arch" type="xml">
            <form string="Cooperative Settlement">
                <header>
                    <button name="action_fetch_data" type="object" string="Fetch Data" class="oe_highlight"/>
                    <button name="action_settle" type="object" string="Settle" class="oe_highlight" invisible="state != 'confirmed'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="partner_id"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="input_debt_amount"/>
                            <field name="harvest_credit_amount"/>
                            <field name="net_settlement_amount"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_farm_credit_score" model="ir.actions.act_window">
        <field name="name">Credit Scores</field>
        <field name="res_model">farm.credit.score</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_farm_coop_settlement" model="ir.actions.act_window">
        <field name="name">Cooperative Settlements</field>
        <field name="res_model">farm.coop.settlement</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>