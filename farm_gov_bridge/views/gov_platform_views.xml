<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>
<record id="view_gov_platform_config_tree" model="ir.ui.view">
        <field name="name">gov.platform.config.list</field>
        <field name="model">gov.platform.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="platform_type" />
                <field name="auto_report_enabled" />
                <field name="active" widget="boolean_toggle" />
            </list>
        </field>
    </record>

    <record id="view_gov_platform_config_form" model="ir.ui.view">
        <field name="name">gov.platform.config.form</field>
        <field name="model">gov.platform.config</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name" />
                        <h1><field name="name" placeholder="e.g. Provincial Agri Platform" /></h1>
                    </div>
                    <group>
                        <group string="Endpoint Configuration">
                            <field name="platform_type" />
                            <field name="endpoint_url" />
                            <field name="api_key" password="True" />
                        </group>
                        <group string="Automation Settings">
                            <field name="auto_report_enabled" />
                            <field name="report_on_event" />
                            <field name="active" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_gov_platform_config" model="ir.actions.act_window">
        <field name="name">Government Platforms</field>
        <field name="res_model">gov.platform.config</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_gov_platform_config" name="Platform Config" parent="menu_farm_gov_root" action="action_gov_platform_config" sequence="50" />
</data>
</odoo>