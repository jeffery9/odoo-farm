<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="farm_ux.AgriNutrientGauge">
        <div class="o_agri_nutrient_gauge d-flex justify-content-around p-3 bg-white border rounded shadow-sm">
            <t t-foreach="nutrients" t-as="n" t-key="n.label">
                <div class="d-flex flex-column align-items-center mx-2">
                    <svg viewBox="0 0 36 36" class="circular-chart" style="width: 60px; height: 60px;">
                        <path class="circle-bg"
                            style="stroke: #eee; stroke-width: 3.8; fill: none;"
                            d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"
                        />
                        <path class="circle"
                            t-attf-style="stroke: #{n.color}; stroke-width: 3.8; stroke-linecap: round; fill: none; transition: stroke-dasharray 0.3s ease;"
                            t-att-stroke-dasharray="getStrokeDash(n.value)"
                            d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"
                        />
                        <text x="18" y="20.35" class="percentage" style="fill: #666; font-family: sans-serif; font-size: 0.5em; text-anchor: middle;"><t t-esc="n.label"/></text>
                    </svg>
                    <div class="mt-1 fw-bold text-secondary small"><t t-esc="n.value.toFixed(1)"/> kg</div>
                </div>
            </t>
        </div>
    </t>
</templates>
