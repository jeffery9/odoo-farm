<?xml version="1.0" encoding="utf-8"?>
<odoo>
<menuitem id="menu_precision_iot_main"
              name="Precision IoT"
              parent="mrp.menu_mrp_manufacturing"
              sequence="29"/>

    
    <record id="precision_iot_command_log_view_tree" model="ir.ui.view">
        <field name="name">precision.iot.command.log.tree</field>
        <field name="model">precision.iot.command.log</field>
        <field name="arch" type="xml">
            <list string="Precision IoT Command Logs">
                <!-- field command_type removed -->
                <field name="device_id"/>
                <field name="status"/>
                <field name="create_date"/>
                <field name="production_id"/>
                <field name="phase_id"/>
            </list>
        </field>
    </record>

    <record id="precision_iot_command_log_view_form" model="ir.ui.view">
        <field name="name">precision.iot.command.log.form</field>
        <field name="model">precision.iot.command.log</field>
        <field name="arch" type="xml">
            <form string="Precision IoT Command Log">
                <header>
                    <button name="action_resend_command" type="object" string="Resend Command" class="btn-secondary" invisible="status != 'failed'"/>
                    <field name="status" widget="statusbar" statusbar_visible="sent,delivered"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                    </div>
                    <group>
                        <group>
                            <!-- field command_type removed -->
                            <field name="device_id"/>
                            <!-- field command_description removed -->
                        </group>
                        <group>
                            <field name="status"/>
                            <field name="create_date"/>
                        </group>
                    </group>
                    <group string="Production Context">
                        <field name="production_id"/>
                        <field name="phase_id"/>
                    </group>
                    <group string="Response Tracking">
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_precision_iot_command_log" model="ir.actions.act_window">
        <field name="name">Precision IoT Command Logs</field>
        <field name="res_model">precision.iot.command.log</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Precision IoT Command Logs
            </p>
            <p>
                View and manage sent commands to IoT devices in precision production processes.
            </p>
        </field>
    </record>

    <menuitem id="menu_precision_iot_command_log"
              name="Command Logs"
              parent="menu_precision_iot_main"
              action="action_precision_iot_command_log"
              sequence="5"/>
</odoo>