<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record id="precision_recipe_phase_view_kanban_iot" model="ir.ui.view">
        <field name="name">precision.recipe.phase.kanban.iot</field>
        <field name="model">precision.recipe.phase</field>
        <field name="inherit_id" ref="precision_production.phase_execution_views.precision_recipe_phase_view_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="attributes">
                <attribute name="js_class">precision_iot_phase_kanban</attribute>
            </xpath>
            <xpath expr="//field[@name='state']" position="after">
                
                <field name="iot_device_ids" widget="many2many"/>
            </xpath>
            <xpath expr="//t[@t-name='kanban-box']//div[@class='card-body p-3']//div[@class='mb-2'][1]" position="after">
                
                <div class="iot-status-indicator" invisible="not iot_device_ids">
                    <i class="fa fa-bolt text-success me-1"/>
                    <i class="fa fa-bolt text-warning me-1"/>
                    <i class="fa fa-bolt text-danger me-1"/>
                    <i class="fa fa-bolt text-secondary me-1"/>
                </div>
            </xpath>
            <xpath expr="//t[@t-name='kanban-box']//div[@class='d-grid gap-2 mt-3']" position="after">
                
                <div class="mt-2 pt-2 border-top" invisible="iot_readings_count == 0">
                    <div class="d-flex justify-content-between" t-foreach="iot_latest_readings" t-as="reading">
                        <small class="text-muted" t-esc="reading.sensor_name"/>
                        <div>
                            <span class="o_iot_reading_value" t-esc="reading.value"/>
                            <span class="o_iot_reading_deviation"
                                  t-att-class="'critical' if reading.deviation_critical else 'warning' if reading.deviation_warning else ''"
                                  t-esc="f'({reading.deviation_percent}% deviation)'"
                                  invisible="not reading.deviation_percent"/>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    
    <record id="precision_recipe_phase_view_list_iot" model="ir.ui.view">
        <field name="name">precision.recipe.phase.list.iot</field>
        <field name="model">precision.recipe.phase</field>
        <field name="inherit_id" ref="precision_production.phase_execution_views.precision_recipe_phase_view_list"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="js_class">precision_iot_phase_kanban</attribute>
            </xpath>
            <xpath expr="//field[@name='state']" position="after">
                <field name="iot_device_status" string="IoT Status" widget="badge"
                       decoration-success="iot_device_status == 'online'"
                       decoration-warning="iot_device_status == 'warning'"
                       decoration-danger="iot_device_status in ['offline', 'error']"
                       optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>