<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Precision IoT Reading Views -->
    <record id="precision_iot_reading_view_tree" model="ir.ui.view">
        <field name="name">precision.iot.reading.tree</field>
        <field name="model">precision.iot.reading</field>
        <field name="arch" type="xml">
            <tree string="Precision IoT Readings" decoration-danger="is_deviation_critical==True" decoration-warning="deviation_percent and deviation_percent>10 and deviation_percent&lt;=25" decoration-info="deviation_percent and deviation_percent&lt;=10">
                <field name="read_datetime"/>
                <field name="device_id"/>
                <field name="sensor_id"/>
                <field name="parameter_name"/>
                <field name="value"/>
                <field name="uom"/>
                <field name="deviation_percent"/>
                <field name="is_deviation_critical"/>
                <field name="production_id"/>
                <field name="phase_id"/>
            </tree>
        </field>
    </record>

    <record id="precision_iot_reading_view_form" model="ir.ui.view">
        <field name="name">precision.iot.reading.form</field>
        <field name="model">precision.iot.reading</field>
        <field name="arch" type="xml">
            <form string="Precision IoT Reading">
                <header>
                    <button name="action_validate_reading" type="object" string="Validate Reading" class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                    </div>
                    <group>
                        <group>
                            <field name="read_datetime"/>
                            <field name="device_id"/>
                            <field name="sensor_id"/>
                            <field name="parameter_name"/>
                        </group>
                        <group>
                            <field name="value"/>
                            <field name="uom"/>
                            <field name="is_valid"/>
                            <field name="validation_message"/>
                        </group>
                    </group>
                    <group string="Quality Metrics">
                        <field name="deviation_percent"/>
                        <field name="is_deviation_critical"/>
                    </group>
                    <group string="Production Context">
                        <field name="production_id"/>
                        <field name="phase_id"/>
                        <field name="workorder_id"/>
                    </group>
                    <group string="Raw Data">
                        <field name="raw_data" widget="ace" options="{'mode': 'json'}"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_precision_iot_reading" model="ir.actions.act_window">
        <field name="name">Precision IoT Readings</field>
        <field name="res_model">precision.iot.reading</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Precision IoT Readings
            </p>
            <p>
                View and analyze IoT sensor readings from precision production processes.
            </p>
        </field>
    </record>

    <menuitem id="menu_precision_iot_reading"
              name="IoT Readings"
              parent="mrp.menu_mrp_manufacturing"
              action="action_precision_iot_reading"
              sequence="32"/>
</odoo>