<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Updated ISL View for Mushroom Production to include new Odoo 19 features -->
    <record id="view_farm_mushroom_production_form_updated" model="ir.ui.view">
        <field name="name">farm.mushroom.production.form.updated</field>
        <field name="model">farm.mushroom.production</field>
        <field name="priority" eval="100"/>
        <field name="arch" type="xml">
            <form string="Mushroom Fruiting Cycle">
                <header>
                    <button name="action_confirm" type="object" string="Confirm" invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="button_mark_done" type="object" string="Mark as Done" invisible="state != 'confirmed'" class="oe_highlight"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>Mushroom Fruiting Cycle</h1>
                    </div>
                    <group>
                        <group string="Order Info (Base)">
                            <field name="product_id"/>
                            <field name="product_qty"/>
                            <field name="bom_id"/>
                        </group>
                        <group string="Efficiency (ISL)">
                            <field name="biological_efficiency"/>
                            <field name="current_flush_number"/>
                        </group>
                    </group>
                    <group string="Security &amp; Configuration">
                        <field name="security_level"/>
                    </group>
                    <notebook>
                        <page string="Configuration">
                            <field name="mushroom_config" widget="ace" options="{'mode': 'json'}"/>
                        </page>
                        
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
