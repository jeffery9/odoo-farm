<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>
<record id="action_triple_bottom_line_metrics" model="ir.actions.act_window">
        <field name="name">Triple Bottom Line Metrics</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">agri.triple.bottom.line.metrics</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add Triple Bottom Line Metrics
            </p>
            <p>
                Track and manage the three pillars of sustainability: People, Planet, and Profit.
            </p>
        </field>
    </record>

    
    <record id="view_triple_bottom_line_metrics_tree" model="ir.ui.view">
        <field name="name">agri.triple.bottom.line.metrics.tree</field>
        <field name="model">agri.triple.bottom.line.metrics</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="date" />
                <field name="economic_score" />
                <field name="environmental_score" />
                <field name="social_score" />
                <field name="overall_sustainability_score" />
                <field name="farm_id" />
            </list>
        </field>
    </record>

    
    <record id="view_triple_bottom_line_metrics_form" model="ir.ui.view">
        <field name="name">agri.triple.bottom.line.metrics.form</field>
        <field name="model">agri.triple.bottom.line.metrics</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_generate_comprehensive_report" type="object" string="Generate Report" class="btn-primary" />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_triple_bottom_line_metrics)d" type="action" class="oe_stat_button" icon="fa-line-chart">
                            <field string="Metrics" name="name" widget="statinfo" />
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="date" />
                            <field name="period_type" />
                            <field name="farm_id" />
                        </group>
                        <group>
                            <field name="economic_score" widget="percentage" />
                            <field name="environmental_score" widget="percentage" />
                            <field name="social_score" widget="percentage" />
                            <field name="overall_sustainability_score" widget="percentage" />
                        </group>
                    </group>

                    <notebook>
                        <page string="Economic Metrics">
                            <group>
                                <group>
                                    <field name="revenue" />
                                    <field name="profit" />
                                    <field name="profit_margin" />
                                    <field name="roi" />
                                </group>
                            </group>
                        </page>

                        <page string="Environmental Metrics">
                            <group>
                                <group>
                                    <field name="carbon_footprint_tco2e" />
                                    <field name="water_usage_m3" />
                                    <field name="resource_efficiency" />
                                    <field name="land_use_efficiency" />
                                </group>
                            </group>
                        </page>

                        <page string="Social Metrics">
                            <group>
                                <group>
                                    <field name="jobs_created" />
                                    <field name="community_investment" />
                                    <field name="safety_incidents" />
                                    <field name="employee_satisfaction" />
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>
</data>
</odoo>