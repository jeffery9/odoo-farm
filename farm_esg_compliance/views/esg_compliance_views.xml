<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>
<record id="view_farm_subsidy_tree" model="ir.ui.view">
        <field name="name">farm.subsidy.list</field>
        <field name="model">farm.subsidy</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'paid'" decoration-info="state == 'approved'">
                <field name="name" />
                <field name="subsidy_type" />
                <field name="amount" />
                <field name="disbursement_date" />
                <field name="state" widget="badge" />
            </list>
        </field>
    </record>

    <record id="action_farm_subsidy" model="ir.actions.act_window">
        <field name="name">Agricultural Subsidies</field>
        <field name="res_model">farm.subsidy</field>
        <field name="view_mode">list,form</field>
    </record>

    
    <record id="view_farm_biodiversity_tree" model="ir.ui.view">
        <field name="name">farm.biodiversity.metric.list</field>
        <field name="model">farm.biodiversity.metric</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="location_id" />
                <field name="date" />
                <field name="species_count" />
                <field name="habitat_quality" widget="priority" />
            </list>
        </field>
    </record>

    <record id="action_farm_biodiversity" model="ir.actions.act_window">
        <field name="name">Biodiversity Monitoring</field>
        <field name="res_model">farm.biodiversity.metric</field>
        <field name="view_mode">list,form</field>
    </record>

    
    <record id="view_farm_export_compliance_tree" model="ir.ui.view">
        <field name="name">farm.export.compliance.list</field>
        <field name="model">farm.export.compliance</field>
        <field name="arch" type="xml">
            <list decoration-success="compliance_status == 'ready'" decoration-danger="compliance_status == 'blocked'">
                <field name="name" />
                <field name="target_market_id" />
                <field name="product_id" />
                <field name="compliance_status" widget="badge" />
            </list>
        </field>
    </record>

    <record id="view_farm_export_compliance_form" model="ir.ui.view">
        <field name="name">farm.export.compliance.form</field>
        <field name="model">farm.export.compliance</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_run_compliance_audit" string="Run Compliance Audit" type="object" class="oe_highlight" />
                    <button name="action_generate_technical_dossier" string="Generate Technical Dossier" type="object" />
                    <field name="compliance_status" widget="statusbar" statusbar_visible="pending,ready,blocked" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Export Ref..." /></h1>
                    </div>
                    <group>
                        <group>
                            <field name="target_market_id" />
                            <field name="product_id" />
                            <field name="standard_id" />
                        </group>
                        <group>
                            <field name="residue_limit_ok" />
                            <field name="phytosanitary_cert_ok" />
                            <field name="labeling_ok" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Audit Log" name="audit_log">
                            <group>
                                <field name="last_audit_run" readonly="1" />
                                <field name="audit_log" readonly="1" />
                            </group>
                            <group string="Detected Gaps">
                                <field name="missing_records" readonly="1" />
                                <field name="withdrawal_violation" readonly="1" />
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_farm_export_compliance" model="ir.actions.act_window">
        <field name="name">Export Compliance Checker</field>
        <field name="res_model">farm.export.compliance</field>
        <field name="view_mode">list,form</field>
    </record>

    
    <record id="view_farm_certification_tree" model="ir.ui.view">
        <field name="name">farm.certification.process.list</field>
        <field name="model">farm.certification.process</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'certified'" decoration-warning="state == 'expired'">
                <field name="name" />
                <field name="cert_type" />
                <field name="valid_to" />
                <field name="state" widget="badge" />
            </list>
        </field>
    </record>

    <record id="action_farm_certification" model="ir.actions.act_window">
        <field name="name">Sustainability Certifications</field>
        <field name="res_model">farm.certification.process</field>
        <field name="view_mode">list,form</field>
    </record>

    
    <menuitem id="menu_farm_esg_compliance_root" name="Compliance &amp; Sustainability" parent="farm_esg.menu_esg_root" sequence="25" />
    
    <menuitem id="menu_farm_subsidy" name="Subsidies Tracking" parent="menu_farm_esg_compliance_root" action="action_farm_subsidy" sequence="10" />
              
    <menuitem id="menu_farm_biodiversity" name="Biodiversity Monitoring" parent="menu_farm_esg_compliance_root" action="action_farm_biodiversity" sequence="20" />
              
    <menuitem id="menu_farm_export_compliance" name="Export Compliance" parent="menu_farm_esg_compliance_root" action="action_farm_export_compliance" sequence="30" />
              
    <menuitem id="menu_farm_certification" name="Certifications" parent="menu_farm_esg_compliance_root" action="action_farm_certification" sequence="40" />
</data>
</odoo>