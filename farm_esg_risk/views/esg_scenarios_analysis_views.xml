<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record id="view_esg_scenarios_analysis_tree" model="ir.ui.view">
        <field name="name">farm.esg.scenarios.analysis.tree</field>
        <field name="model">farm.esg.scenarios.analysis</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="scenario_type"/>
                <field name="analysis_status"/>
                <field name="predicted_carbon_reduction"/>
                <field name="predicted_roi"/>
                <field name="confidence_level"/>
                <field name="start_date"/>
                <field name="end_date"/>
            </list>
        </field>
    </record>

    
    <record id="view_esg_scenarios_analysis_form" model="ir.ui.view">
        <field name="name">farm.esg.scenarios.analysis.form</field>
        <field name="model">farm.esg.scenarios.analysis</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_run_analysis" type="object" string="Run Analysis" class="oe_highlight"/>
                    <button name="action_approve_scenario" type="object" string="Approve Scenario" class="oe_highlight" invisible="analysis_status != 'completed'"/>
                    <button name="action_reject_scenario" type="object" string="Reject Scenario" invisible="analysis_status != 'completed'"/>
                    <button name="action_schedule_review" type="object" string="Schedule Review"/>
                    <button name="action_visualize_scenario" type="object" string="Visualize Scenario"/>
                    <field name="analysis_status" widget="statusbar" statusbar_visible="draft,under_analysis,completed,approved,rejected"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_link_to_esg_modules" type="object" class="oe_stat_button" icon="fa-link">
                            <div>Link to ESG Modules</div>
                        </button>
                    </div>
                    <group>
                        <group name="basic_info" string="Scenario Information">
                            <field name="name"/>
                            <field name="scenario_type"/>
                            <field name="description"/>
                        </group>
                        <group name="timeline" string="Timeline">
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="timeline_months"/>
                            <field name="monitoring_frequency"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Baseline Data">
                            <group>
                                <field name="baseline_carbon_emissions"/>
                                <field name="baseline_water_usage"/>
                                <field name="baseline_energy_consumption"/>
                                <field name="baseline_biodiversity_score"/>
                                <field name="baseline_waste_generation"/>
                            </group>
                        </page>
                        <page string="Target Data">
                            <group>
                                <field name="target_carbon_emissions"/>
                                <field name="target_water_usage"/>
                                <field name="target_energy_consumption"/>
                                <field name="target_biodiversity_score"/>
                                <field name="target_waste_generation"/>
                            </group>
                        </page>
                        <page string="Scenario Parameters">
                            <group>
                                <field name="scenario_parameters" widget="ace" options="{'mode': 'json'}"/>
                                <field name="implementation_actions"/>
                                <field name="resource_requirements"/>
                                <field name="scenario_complexity"/>
                            </group>
                        </page>
                        <page string="Predicted Outcomes">
                            <group>
                                <field name="predicted_carbon_reduction"/>
                                <field name="predicted_water_savings"/>
                                <field name="predicted_energy_savings"/>
                                <field name="predicted_biodiversity_improvement"/>
                                <field name="predicted_cost_impact"/>
                                <field name="predicted_roi"/>
                                <field name="confidence_level"/>
                                <field name="prediction_accuracy"/>
                            </group>
                        </page>
                        <page string="Risk Assessment">
                            <group>
                                <field name="scenario_risk_level"/>
                                <field name="risk_factors"/>
                                <field name="mitigation_strategies"/>
                            </group>
                        </page>
                        <page string="Stakeholder Impact">
                            <group>
                                <field name="stakeholder_impact_assessment"/>
                                <field name="community_benefit_score"/>
                                <field name="employee_impact_score"/>
                            </group>
                        </page>
                        <page string="Analysis Results">
                            <group>
                                <field name="analysis_results" readonly="1"/>
                                <field name="recommendation"/>
                                <field name="next_review_date"/>
                            </group>
                        </page>
                        <page string="Integration">
                            <group>
                                <field name="linked_kpi_ids" widget="many2many_tags" options="{'color_field': 'kpi_category'}"/>
                                <field name="linked_compliance_ids" widget="many2many_tags"/>
                                <field name="linked_assessment_ids" widget="many2many_tags"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    
    <record id="view_esg_scenarios_analysis_search" model="ir.ui.view">
        <field name="name">farm.esg.scenarios.analysis.search</field>
        <field name="model">farm.esg.scenarios.analysis</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="scenario_type"/>
                <field name="analysis_status"/>
                <field name="scenario_risk_level"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <separator/>
                <filter name="filter_completed" string="Completed" domain="[('analysis_status', '=', 'completed')]"/>
                <filter name="filter_approved" string="Approved" domain="[('analysis_status', '=', 'approved')]"/>
                <filter name="filter_high_risk" string="High Risk" domain="[('scenario_risk_level', '=', 'high')]"/>
                <filter name="filter_carbon" string="Carbon Scenarios" domain="[('scenario_type', '=', 'carbon_footprint')]"/>
                <filter name="filter_water" string="Water Scenarios" domain="[('scenario_type', '=', 'water_efficiency')]"/>
                <group>
                    <filter name="group_by_scenario_type" string="Scenario Type" context="{'group_by': 'scenario_type'}"/>
                    <filter name="group_by_status" string="Analysis Status" context="{'group_by': 'analysis_status'}"/>
                    <filter name="group_by_risk_level" string="Risk Level" context="{'group_by': 'scenario_risk_level'}"/>
                </group>
            </search>
        </field>
    </record>

    
    <record id="action_esg_scenarios_analysis" model="ir.actions.act_window">
        <field name="name">ESG Scenarios Analysis</field>
        <field name="res_model">farm.esg.scenarios.analysis</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_esg_scenarios_analysis_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Analyze sustainability scenarios and predict outcomes
            </p>
            <p>
                Create and analyze different sustainability scenarios to predict
                environmental, social, and governance outcomes for your farming operations.
            </p>
        </field>
    </record>

    
    <menuitem id="esg_scenarios_analysis_menu" name="Scenarios Analysis"
              parent="esg_risk_menu" sequence="70"
              action="action_esg_scenarios_analysis"/>
</odoo>