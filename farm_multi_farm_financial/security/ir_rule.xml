<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- 1. Internal Settlement Rules -->
        <record id="rule_internal_settlement_worker_own" model="ir.rule">
            <field name="name">Worker: See Own Settlements Only</field>
            <field name="model_id" ref="model_internal_settlement"/>
            <!-- Can see if they are the payer OR the payee -->
            <field name="domain_force">['|', ('from_entity_id', '=', user.partner_id.id), ('to_entity_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('farm_core.group_farm_worker'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <record id="rule_internal_settlement_manager_all" model="ir.rule">
            <field name="name">Manager: See All Settlements in Coop</field>
            <field name="model_id" ref="model_internal_settlement"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('farm_core.group_farm_manager'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <!-- 2. Dividend Line Rules -->
        <record id="rule_dividend_line_worker_own" model="ir.rule">
            <field name="name">Worker: See Own Dividends Only</field>
            <field name="model_id" ref="model_dividend_line"/>
            <field name="domain_force">[('member_id.partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('farm_core.group_farm_worker'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <record id="rule_dividend_line_manager_all" model="ir.rule">
            <field name="name">Manager: See All Dividends</field>
            <field name="model_id" ref="model_dividend_line"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('farm_core.group_farm_manager'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>
    </data>
</odoo>
