<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Agricultural Cost Template Views -->
    <record id="view_agri_cost_template_tree" model="ir.ui.view">
        <field name="name">agri.cost.template.tree</field>
        <field name="model">agri.cost.template</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="category"/>
                <field name="unit_type"/>
                <field name="unit_cost"/>
                <field name="is_active"/>
            </tree>
        </field>
    </record>

    <record id="view_agri_cost_template_form" model="ir.ui.view">
        <field name="name">agri.cost.template.form</field>
        <field name="model">agri.cost.template</field>
        <field name="arch" type="xml">
            <form>
                <header>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="category"/>
                            <field name="is_active"/>
                        </group>
                        <group>
                            <field name="unit_type"/>
                            <field name="unit_cost"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Details" attrs="{'invisible': [('category', 'not in', ['labor', 'machinery', 'fertilizer', 'pesticide'])]}">
                            <group attrs="{'invisible': [('category', '!=', 'labor')]}">
                                <field name="labor_type"/>
                            </group>
                            <group attrs="{'invisible': [('category', '!=', 'machinery')]}">
                                <field name="machinery_type"/>
                            </group>
                            <group attrs="{'invisible': [('category', '!=', 'fertilizer')]}">
                                <field name="fertilizer_type"/>
                            </group>
                            <group attrs="{'invisible': [('category', '!=', 'pesticide')]}">
                                <field name="pesticide_type"/>
                            </group>
                        </page>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Cost Calculation Views -->
    <record id="view_agri_cost_calculation_form" model="ir.ui.view">
        <field name="name">agri.cost.calculation.form</field>
        <field name="model">agri.cost.calculation</field>
        <field name="arch" type="xml">
            <form string="Agricultural Cost Calculation">
                <sheet>
                    <group>
                        <group string="Context">
                            <field name="task_id"/>
                            <field name="land_parcel_id"/>
                            <field name="area_value"/>
                            <field name="area_unit"/>
                        </group>
                        <group string="Calculated Costs">
                            <field name="total_seedling_cost"/>
                            <field name="total_fertilizer_cost"/>
                            <field name="total_pesticide_cost"/>
                            <field name="total_labor_cost"/>
                            <field name="total_machinery_cost"/>
                            <field name="total_irrigation_cost"/>
                            <field name="total_other_cost"/>
                            <field name="total_cost"/>
                        </group>
                    </group>
                    <group string="Cost Breakdown">
                        <field name="cost_line_ids" nolabel="1" context="{'tree_view_ref': 'farm_financial.view_agri_cost_calculation_line_tree'}">
                            <tree editable="bottom">
                                <field name="template_id"/>
                                <field name="quantity"/>
                                <field name="unit_cost"/>
                                <field name="total_cost"/>
                            </tree>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Cost Calculation Line Views -->
    <record id="view_agri_cost_calculation_line_tree" model="ir.ui.view">
        <field name="name">agri.cost.calculation.line.tree</field>
        <field name="model">agri.cost.calculation.line</field>
        <field name="arch" type="xml">
            <tree>
                <field name="template_id"/>
                <field name="quantity"/>
                <field name="unit_cost"/>
                <field name="total_cost"/>
            </tree>
        </field>
    </record>

    <!-- Cost Allocation Wizard Views -->
    <record id="view_agri_cost_allocation_wizard_form" model="ir.ui.view">
        <field name="name">agri.cost.allocation.wizard.form</field>
        <field name="model">agri.cost.allocation.wizard</field>
        <field name="arch" type="xml">
            <form string="Agricultural Cost Allocation">
                <sheet>
                    <group col="4">
                        <group string="Production Task">
                            <field name="task_id"/>
                            <field name="land_parcel_id"/>
                            <field name="area_value"/>
                            <field name="area_unit"/>
                        </group>
                        <group string="Cost Summary">
                            <field name="total_calculated_cost"/>
                            <field name="total_applied_cost"/>
                        </group>
                    </group>
                    <group string="Cost Allocation">
                        <field name="cost_line_ids" nolabel="1" context="{'tree_view_ref': 'farm_financial.view_agri_cost_allocation_line_tree'}">
                            <tree editable="bottom">
                                <field name="template_id" options="{'no_create': True}"/>
                                <field name="category" invisible="1"/>
                                <field name="unit_type" invisible="1"/>
                                <field name="unit_cost"/>
                                <field name="quantity"/>
                                <field name="total_cost"/>
                            </tree>
                        </field>
                    </group>
                </sheet>
                <footer>
                    <button name="action_apply_cost_allocation" string="Apply Cost Allocation" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Cost Allocation Line Views -->
    <record id="view_agri_cost_allocation_line_tree" model="ir.ui.view">
        <field name="name">agri.cost.allocation.line.tree</field>
        <field name="model">agri.cost.allocation.line.wizard</field>
        <field name="arch" type="xml">
            <tree>
                <field name="template_id"/>
                <field name="unit_cost"/>
                <field name="quantity"/>
                <field name="total_cost"/>
            </tree>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_agri_cost_template" model="ir.actions.act_window">
        <field name="name">Agricultural Cost Templates</field>
        <field name="res_model">agri.cost.template</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_agri_cost_allocation_wizard" model="ir.actions.act_window">
        <field name="name">Cost Allocation Wizard</field>
        <field name="res_model">agri.cost.allocation.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Menu Items -->
    <menuitem id="menu_agri_cost_root" name="Agricultural Costing"
              parent="farm_financial.farm_financial_root" sequence="20"/>

    <menuitem id="menu_agri_cost_templates" name="Cost Templates"
              action="action_agri_cost_template"
              parent="menu_agri_cost_root" sequence="10"/>

    <menuitem id="menu_agri_cost_allocation" name="Cost Allocation Wizard"
              action="action_agri_cost_allocation_wizard"
              parent="menu_agri_cost_root" sequence="20"/>

</odoo>