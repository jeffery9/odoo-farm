<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_task_form2_inherit_farm_financial" model="ir.ui.view">
        <field name="name">project.task.form.farm.financial</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="object" name="action_view_analytic_lines" 
                        icon="fa-money" invisible="not analytic_account_id"
                        groups="farm_core.group_farm_manager">
                    <div class="o_stat_info">
                        <span class="o_stat_value">
                            <field name="total_production_costs" widget="monetary"/>
                        </span>
                        <span class="o_stat_text">Total Costs</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//field[@name='user_ids']" position="after">
                <field name="analytic_account_id" groups="analytic.group_analytic_accounting"/>
            </xpath>
        </field>
    </record>

    <!-- 增加跳转到明细的方法 -->
    <record id="project_task_action_view_analytic" model="ir.actions.act_window">
        <field name="name">Analytic Lines</field>
        <field name="res_model">account.analytic.line</field>
        <field name="view_mode">list,form,graph,pivot</field>
    </record>

    <menuitem id="menu_farm_finance_root" name="Finance &amp; Costs" parent="farm_core.menu_farm_root" sequence="80"/>

    <!-- CPA Analysis Views -->
    <record id="view_farm_cpa_analysis_tree" model="ir.ui.view">
        <name>farm.cpa.analysis.list</name>
        <model>farm.cpa.analysis</model>
        <arch type="xml">
            <list decoration-success="margin_percentage > 20" decoration-danger="margin_percentage &lt; 0">
                <field name="name"/>
                <field name="activity_id"/>
                <field name="location_id"/>
                <field name="total_production_cost"/>
                <field name="harvest_revenue"/>
                <field name="gross_profit"/>
                <field name="margin_percentage" widget="percentage"/>
                <field name="state" widget="badge"/>
            </list>
        </arch>
    </record>

    <record id="view_farm_cpa_analysis_form" model="ir.ui.view">
        <name>farm.cpa.analysis.form</name>
        <model>farm.cpa.analysis</model>
        <arch type="xml">
            <form>
                <header>
                    <button name="action_calculate_cpa" string="Calculate CPA" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="activity_id"/>
                            <field name="location_id"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="Cost Breakdown">
                        <group>
                            <field name="total_material_cost"/>
                            <field name="total_labor_cost"/>
                        </group>
                        <group>
                            <field name="total_machinery_cost"/>
                            <field name="total_indirect_cost"/>
                        </group>
                    </group>
                    <div class="oe_right">
                        <group class="oe_subtotal_footer">
                            <field name="total_production_cost" class="oe_subtotal_footer_separator"/>
                            <field name="harvest_revenue"/>
                            <field name="gross_profit" class="oe_subtotal_footer_separator"/>
                            <field name="margin_percentage"/>
                        </group>
                    </div>
                </sheet>
                <chatter/>
            </form>
        </arch>
    </record>

    <record id="action_farm_cpa_analysis" model="ir.actions.act_window">
        <name>CPA Analysis (Cost Per Parcel)</name>
        <res_model>farm.cpa.analysis</res_model>
        <view_mode>list,form,pivot,graph</view_mode>
    </record>

    <menuitem id="menu_farm_cpa_analysis" name="CPA Analysis (Single Parcel)" 
              parent="menu_farm_finance_root" action="action_farm_cpa_analysis" sequence="10"/>
</odoo>
