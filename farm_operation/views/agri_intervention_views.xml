<?xml version="1.0" encoding="UTF-8"?>
<odoo>
<data>
    <!-- 重命名 MRP 菜单为 "Farm Interventions" -->
    <record id="mrp.menu_mrp_root" model="ir.ui.menu">
        <field name="name">Farm Interventions</field>
        <field name="web_icon">farm_operation,static/description/icon.png</field>
    </record>

    <!-- Mrp Production Form View Inherit -->
    <record id="mrp_production_form_view_inherit_farm_op" model="ir.ui.view">
        <field name="name">mrp.production.form.inherit.farm.op</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_submit_for_approval" string="Submit for Approval" type="object" class="btn-primary" invisible="approval_state != 'draft'"/>
                <button name="action_approve" string="Approve" type="object" class="btn-success" invisible="approval_state != 'to_approve'" groups="mrp.group_mrp_manager"/>
                <button name="action_reject" string="Reject" type="object" class="btn-danger" invisible="approval_state != 'to_approve'" groups="mrp.group_mrp_manager"/>
                <button name="action_start_work" string="Start Agri Work" type="object" class="btn-info" invisible="state != 'confirmed' or is_working"/>
                <button name="action_stop_work" string="Stop Agri Work" type="object" class="btn-warning" invisible="not is_working"/>
            </xpath>
            <xpath expr="//field[@name='bom_id']" position="attributes">
                <attribute name="string">Recipe/Formula</attribute>
            </xpath>
            <xpath expr="//sheet" position="before">
                <widget name="agri_gating_audit"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                    <page string="Sustainability &amp; Value" name="sustainability">
                        <group>
                            <group string="Carbon &amp; Impact">
                                <field name="carbon_intensity" widget="gauge" options="{'max_field': '50', 'label': 'kg CO2e'}" />
                                <field name="esg_score" />
                                <field name="is_eco_blocked" readonly="1" />
                            </group>
                            <group string="Community Clearing">
                                <field name="impact_credits" decoration-success="impact_credits &gt; 0" widget="monetary" />
                                <field name="clearing_status" widget="badge" decoration-info="clearing_status == 'calculated'" decoration-success="clearing_status == 'settled'" />
                            </group>
                        </group>
                    </page>
                    <page string="Spatial &amp; Evidence" name="evidence">
                        <group>
                            <group string="Spatial Compliance Audit">
                                <widget name="agri_spatial_gauge"/>
                            </group>
                            <group string="Physical Grounding">
                                <field name="geo_point" />
                                <field name="spatial_grid_id" />
                            </group>
                        </group>
                        <group>
                            <group string="AI Audit">
                                <field name="audit_confidence" widget="progressbar" />
                                <field name="audit_status" widget="badge" decoration-danger="audit_status == 'fraudulent'" decoration-success="audit_status == 'verified'" />
                            </group>
                        </group>
                        <group string="Quality Fingerprint (Immutable Proof)">
                            <field name="quality_fingerprint" widget="ace" options="{'mode': 'json'}" />
                        </group>
                    </page>
                    <page string="Soil Nutrient Balance" name="nutrient_balance" invisible="intervention_type not in ['fertilizing', 'tillage']">
                        <group>
                            <group string="Nutrient Application Visualization">
                                <widget name="agri_nutrient_gauge" />
                            </group>
                            <group string="Current Application (Pure Nutrient)">
                                <field name="pure_n_qty" />
                                <field name="pure_p_qty" />
                                <field name="pure_k_qty" />
                            </group>
                        </group>
                    </page>
                </xpath>
        </field>
    </record>

    <record id="mrp_production_kanban_view_inherit_farm" model="ir.ui.view">
        <field name="name">mrp.production.kanban.inherit.farm</field>
        <field name="model">mrp.production</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1">
                <field name="name" />
                <field name="product_id" />
                <field name="intervention_type" />
                <field name="state" />
                <field name="weather_gating_status" />
                <field name="compliance_gating_status" />
                <field name="iot_status" />
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <strong class="o_kanban_record_title"><field name="name" /></strong>
                                <field name="state" widget="label_selection" options="{'classes': {'draft': 'default', 'confirmed': 'info', 'progress': 'warning', 'done': 'success'}}" />
                            </div>
                            <div class="o_kanban_record_body">
                                <div><i class="fa fa-tag me-1" /> <field name="intervention_type" /></div>
                                <div><i class="fa fa-cube me-1" /> <field name="product_id" /></div>
                            </div>
                            <div class="o_kanban_record_bottom mt-2 d-flex justify-content-between align-items-center">
                                <div class="d-flex gap-2">
                                    <i class="fa fa-sun-o" t-if="record.weather_gating_status.raw_value == 'safe'" title="Weather Safe" style="color: green;" />
                                    <i class="fa fa-umbrella" t-if="record.weather_gating_status.raw_value == 'blocked'" title="Weather Blocked" style="color: red;" />
                                    <i class="fa fa-shield" t-if="record.compliance_gating_status.raw_value == 'compliant'" title="Compliant" style="color: green;" />
                                    <i class="fa fa-ban" t-if="record.compliance_gating_status.raw_value == 'blocked'" title="Non-Compliant" style="color: red;" />
                                    <i class="fa fa-wifi" t-if="record.iot_status.raw_value == 'connected'" title="IoT Connected" style="color: green;" />
                                    <i class="fa fa-times-circle" t-if="record.iot_status.raw_value == 'offline'" title="IoT Offline" style="color: orange;" />
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="responsible_id" widget="many2one_avatar_user" />
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="mrp_production_calendar_view_inherit_farm" model="ir.ui.view">
        <field name="name">mrp.production.calendar.inherit.farm</field>
        <field name="model">mrp.production</field>
        <field name="arch" type="xml">
            <calendar string="Intervention Schedule" date_start="date_start" date_stop="date_finished" color="intervention_type" quick_create="0">
                <field name="name" />
                <field name="product_id" />
                <field name="intervention_type" filters="1" />
            </calendar>
        </field>
    </record>

    <record id="mrp_production_pivot_view_inherit_farm" model="ir.ui.view">
        <field name="name">mrp.production.pivot.inherit.farm</field>
        <field name="model">mrp.production</field>
        <field name="arch" type="xml">
            <pivot string="Intervention Analysis" sample="1">
                <field name="date_finished" interval="month" type="col" />
                <field name="intervention_type" type="row" />
                <field name="product_qty" type="measure" />
                <field name="total_agri_cost" type="measure" />
            </pivot>
        </field>
    </record>

    <record id="mrp.mrp_production_action" model="ir.actions.act_window">
        <field name="view_mode">list,kanban,form,calendar,pivot,graph</field>
    </record>
</data>
</odoo>
