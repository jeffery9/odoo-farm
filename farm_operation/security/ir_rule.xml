<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- RLS for Farm Operations (Tasks) -->
        <!-- Odoo base project handles basic visibility, but we enforce strict tree logic for specialists -->
        <record id="rule_project_task_owner_hierarchy" model="ir.rule">
            <field name="name">Farm Owner: See Tasks of Subordinate Workers</field>
            <field name="model_id" ref="project.model_project_task"/>
            <field name="domain_force">['|', ('user_ids', 'in', [user.id]), ('user_ids.partner_id.parent_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('farm_core.group_farm_specialist'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>
    </data>
</odoo>
