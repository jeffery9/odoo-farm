<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>
<record id="view_mrp_production_form_isl_nav" model="ir.ui.view">
        <field name="name">mrp.production.form.isl.nav</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view" />
        <field name="arch" type="xml">
            <header position="inside">
                <div class="o_row" invisible="not isl_record_type">
                    <field name="isl_record_type" widget="badge" decoration-info="isl_record_type" />
                </div>
                <button name="action_view_isl_record" type="object" string="View ISL Record" class="btn-primary" invisible="not industry_type" />
            </header>
        </field>
    </record>
</data>
</odoo>