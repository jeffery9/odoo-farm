<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 初始可持续性指标数据 -->
    <record id="sustainability_metric_economic_target" model="farm.sustainability.metric">
        <field name="name">经济目标达成率</field>
        <field name="code">ECONOMIC_TARGET_RATE</field>
        <field name="category">economic</field>
        <field name="unit">百分比</field>
        <field name="description">经济目标的达成率</field>
        <field name="target_value">95.0</field>
        <field name="calculation_method">manual</field>
    </record>

    <record id="sustainability_metric_environmental_score" model="farm.sustainability.metric">
        <field name="name">环境影响评分</field>
        <field name="code">ENVIRONMENTAL_SCORE</field>
        <field name="category">environmental</field>
        <field name="unit">分</field>
        <field name="description">环境影响综合评分</field>
        <field name="target_value">80.0</field>
        <field name="calculation_method">manual</field>
    </record>

    <record id="sustainability_metric_social_impact" model="farm.sustainability.metric">
        <field name="name">社会影响力评分</field>
        <field name="code">SOCIAL_IMPACT_SCORE</field>
        <field name="category">social</field>
        <field name="unit">分</field>
        <field name="description">社会影响力综合评分</field>
        <field name="target_value">75.0</field>
        <field name="calculation_method">manual</field>
    </record>

    <!-- 初始循环经济流程数据 -->
    <record id="circular_flow_example" model="farm.sustainability.circular.flow">
        <field name="name">农作物秸秆再利用</field>
        <field name="code">CF-001</field>
        <field name="flow_type">waste_to_resource</field>
        <field name="description">将农作物秸秆转化为有机肥料</field>
        <field name="input_quantity">10.0</field>
        <field name="output_quantity">7.0</field>
        <field name="processing_cost">500.0</field>
        <field name="revenue">1000.0</field>
        <field name="status">completed</field>
    </record>
</odoo>