<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_matter_tracking_form_inherit_aquaculture" model="ir.ui.view">
        <field name="name">stock.matter.tracking.form.inherit.aquaculture</field>
        <field name="model">stock.matter.tracking</field>
        <field name="inherit_id" ref="farm_core.view_stock_matter_tracking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='last_location_update']" position="after">
                <field name="aquaculture_asset_id" invisible="not aquaculture_asset_id"/>
                <field name="lss_unit_id" invisible="not lss_unit_id"/>
            </xpath>
        </field>
    </record>
</odoo>
