<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_agri_esg_red_line_config_tree" model="ir.ui.view">
        <field name="name">agri.esg.red.line.config.tree</field>
        <field name="model">agri.esg.red.line.config</field>
        <field name="arch" type="xml">
            <list string="ESG Red Line Configs">
                <field name="name"/>
                <field name="red_line_type"/>
            </list>
        </field>
    </record>

    <record id="action_agri_esg_red_line_config" model="ir.actions.act_window">
        <field name="name">ESG Red Lines</field>
        <field name="res_model">agri.esg.red.line.config</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
