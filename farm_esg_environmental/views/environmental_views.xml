<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ESG Environmental Report Views -->
    <record id="view_esg_environmental_report_tree" model="ir.ui.view">
        <field name="name">esg.environmental.report.tree</field>
        <field name="model">esg.environmental.report</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="report_date"/>
                <field name="report_period"/>
                <field name="environmental_score"/>
                <field name="overall_esg_score"/>
                <field name="year"/>
            </list>
        </field>
    </record>

    <record id="view_esg_environmental_report_form" model="ir.ui.view">
        <field name="name">esg.environmental.report.form</field>
        <field name="model">esg.environmental.report</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_generate_report" type="object" string="Generate Report" class="oe_highlight"/>
                    <field name="assessment_status" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="report_period"/>
                            <field name="year"/>
                        </group>
                        <group>
                            <field name="report_date"/>
                            <field name="company_id"/>
                            <field name="assessment_status"/>
                        </group>
                    </group>
                    <group string="ESG Scores" col="4">
                        <field name="environmental_score"/>
                        <field name="social_score"/>
                        <field name="governance_score"/>
                        <field name="overall_esg_score"/>
                    </group>
                    <notebook>
                        <page string="Environmental Metrics">
                            <group>
                                <field name="avg_overall_impact"/>
                                <field name="avg_shannon_diversity"/>
                                <field name="avg_water_use_efficiency"/>
                                <field name="total_environmental_assessments"/>
                            </group>
                            <group string="Environmental KPIs">
                                <field name="carbon_footprint_tco2e"/>
                                <field name="water_stress_score"/>
                                <field name="biodiversity_risk_score"/>
                            </group>
                        </page>
                        <page string="Related Data" name="related_data">
                            <group string="Environmental Assessments">
                                <field name="environmental_assessment_ids" nolabel="1"/>
                            </group>
                            <group string="Biodiversity Tracking">
                                <field name="biodiversity_tracking_ids" nolabel="1"/>
                            </group>
                            <group string="Water Efficiency Records">
                                <field name="water_efficiency_ids" nolabel="1"/>
                            </group>
                        </page>
                        <page string="Performance Analysis">
                            <group string="Target Achievement">
                                <field name="total_targets"/>
                                <field name="achieved_targets"/>
                                <field name="achievement_rate"/>
                            </group>
                            <group string="Compliance Metrics">
                                <field name="compliance_rate"/>
                                <field name="audit_findings"/>
                                <field name="corrective_actions"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_esg_environmental_report" model="ir.actions.act_window">
        <field name="name">ESG Environmental Reports</field>
        <field name="res_model">esg.environmental.report</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- ESG Environmental Compliance Views -->
    <record id="view_esg_environmental_compliance_tree" model="ir.ui.view">
        <field name="name">esg.environmental.compliance.tree</field>
        <field name="model">esg.environmental.compliance</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="assessment_date"/>
                <field name="compliance_type"/>
                <field name="assessment_status"/>
                <field name="overall_esg_score"/>
                <field name="environmental_risk_level"/>
            </list>
        </field>
    </record>

    <record id="view_esg_environmental_compliance_form" model="ir.ui.view">
        <field name="name">esg.environmental.compliance.form</field>
        <field name="model">esg.environmental.compliance</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start_assessment" type="object" string="Start Assessment" invisible="assessment_status != 'draft'"/>
                    <button name="action_complete_assessment" type="object" string="Complete Assessment" invisible="assessment_status != 'in_progress'"/>
                    <field name="assessment_status" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="compliance_type"/>
                            <field name="assessment_type"/>
                        </group>
                        <group>
                            <field name="assessment_date"/>
                            <field name="assessor_id"/>
                            <field name="assessment_status"/>
                        </group>
                    </group>
                    <group string="Environmental Data">
                        <field name="carbon_emissions_tco2e"/>
                        <field name="energy_consumption_kwh"/>
                        <field name="waste_generation_kg"/>
                        <field name="environmental_risk_level"/>
                    </group>
                    <group string="ESG Scores" col="4">
                        <field name="environmental_score"/>
                        <field name="social_score"/>
                        <field name="governance_score"/>
                        <field name="overall_esg_score"/>
                    </group>
                    <notebook>
                        <page string="Compliance Details">
                            <group>
                                <field name="certification_body"/>
                                <field name="certification_number"/>
                                <field name="scope_statement"/>
                            </group>
                            <group string="Environmental Indicators">
                                <field name="environmental_indicator_ids" nolabel="1"/>
                            </group>
                        </page>
                        <page string="Assessment Lines">
                            <field name="assessment_line_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="indicator_id"/>
                                    <field name="actual_value"/>
                                    <field name="target_value"/>
                                    <field name="performance_score"/>
                                    <field name="verification_status"/>
                                </list>
                            </field>
                        </page>
                        <page string="Issues and Actions">
                            <group string="Non-Compliance Issues">
                                <field name="non_compliance_issues" nolabel="1"/>
                            </group>
                            <group string="Corrective Actions">
                                <field name="corrective_actions" nolabel="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_esg_environmental_compliance" model="ir.actions.act_window">
        <field name="name">ESG Environmental Compliance</field>
        <field name="res_model">esg.environmental.compliance</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>