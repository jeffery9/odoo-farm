<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- RLS for Stock Lots (Harvest/Inventory Privacy) -->
        <!-- We must first ensure stock.lot has an owner_id or equivalent. For this rule we assume stock.lot has 'partner_id' (which is standard Odoo for owner) -->
        <record id="rule_stock_lot_worker" model="ir.rule">
            <field name="name">Worker: See Own Lots Only</field>
            <field name="model_id" ref="stock.model_stock_lot"/>
            <field name="domain_force">['|', ('partner_id', '=', user.partner_id.id), ('partner_id', '=', False)]</field>
            <field name="groups" eval="[(4, ref('farm_core.group_farm_worker'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <record id="rule_stock_lot_owner_hierarchy" model="ir.rule">
            <field name="name">Farm Owner: See Own and Subordinate Lots</field>
            <field name="model_id" ref="stock.model_stock_lot"/>
            <field name="domain_force">['|', '|', ('partner_id', '=', user.partner_id.id), ('partner_id.parent_id', '=', user.partner_id.id), ('partner_id', '=', False)]</field>
            <field name="groups" eval="[(4, ref('farm_core.group_farm_specialist'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <record id="rule_stock_lot_manager" model="ir.rule">
            <field name="name">Manager: See All Lots</field>
            <field name="model_id" ref="stock.model_stock_lot"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('farm_core.group_farm_manager'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>
    </data>
</odoo>
