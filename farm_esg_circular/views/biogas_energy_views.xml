<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record id="action_biogas_production" model="ir.actions.act_window">
        <field name="name">Biogas Production</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">agri.biogas.production</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Record Biogas Production from Waste
            </p>
            <p>
                Track biogas production from agricultural waste to quantify energy recovery and environmental benefits.
            </p>
        </field>
    </record>

    
    <record id="view_biogas_production_tree" model="ir.ui.view">
        <field name="name">agri.biogas.production.tree</field>
        <field name="model">agri.biogas.production</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="production_date"/>
                <field name="input_waste_type"/>
                <field name="biogas_volume"/>
                <field name="energy_output_kwh"/>
                <field name="coal_equivalent_ton"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    
    <record id="view_biogas_production_form" model="ir.ui.view">
        <field name="name">agri.biogas.production.form</field>
        <field name="model">agri.biogas.production</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start_production" type="object" string="Start Production" class="btn-primary" invisible="status != 'planned'"/>
                    <button name="action_complete_production" type="object" string="Complete Production" class="btn-success" invisible="status != 'in_progress'"/>
                    <button name="action_generate_energy_report" type="object" string="Energy Report" class="btn-info"/>
                    <field name="status" widget="statusbar" statusbar_visible="planned,in_progress,completed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_biogas_production)d" type="action" class="oe_stat_button" icon="fa-fire">
                            <field string="Biogas Production" name="name" widget="statinfo"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="production_date"/>
                            <field name="input_waste_type"/>
                        </group>
                        <group>
                            <field name="input_quantity"/>
                            <field name="input_uom"/>
                            <field name="status"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Production Data">
                            <group>
                                <group string="Biogas Output">
                                    <field name="biogas_volume"/>
                                    <field name="methane_content"/>
                                </group>
                                <group string="Energy Calculations">
                                    <field name="energy_output_kwh"/>
                                    <field name="coal_equivalent_ton"/>
                                    <field name="co2_reduction_ton"/>
                                </group>
                            </group>
                        </page>

                        <page string="Process Parameters">
                            <group>
                                <group>
                                    <field name="digester_temperature"/>
                                    <field name="retention_time_days"/>
                                    <field name="ph_level"/>
                                </group>
                                <group>
                                    <field name="digester_id"/>
                                    <field name="production_location_id"/>
                                </group>
                            </group>
                        </page>

                        <page string="Environmental Impact">
                            <group>
                                <group>
                                    <field name="related_carbon_impact_id"/>
                                    <field name="related_circular_flow_id"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    
    <record id="action_energy_recovery_integration" model="ir.actions.act_window">
        <field name="name">Energy Recovery Integration</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">agri.energy.recovery.integration</field>
        <field name="view_mode">list,form</field>
    </record>

    
    <record id="view_energy_recovery_integration_tree" model="ir.ui.view">
        <field name="name">agri.energy.recovery.integration.tree</field>
        <field name="model">agri.energy.recovery.integration</field>
        <field name="arch" type="xml">
            <list>
                <field name="biogas_production_id"/>
                <field name="co2_reduction_ton"/>
                <field name="energy_output_kwh"/>
                <field name="integration_status"/>
            </list>
        </field>
    </record>
</odoo>