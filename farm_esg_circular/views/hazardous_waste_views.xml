<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record id="action_hazardous_waste_record" model="ir.actions.act_window">
        <field name="name">Hazardous Waste Records</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">agri.hazardous.waste.record</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Record Hazardous Waste Disposal
            </p>
            <p>
                Track and manage hazardous agricultural waste disposal to meet environmental compliance requirements.
            </p>
        </field>
    </record>

    
    <record id="view_hazardous_waste_record_tree" model="ir.ui.view">
        <field name="name">agri.hazardous.waste.record.tree</field>
        <field name="model">agri.hazardous.waste.record</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="waste_type"/>
                <field name="collection_date"/>
                <field name="quantity"/>
                <field name="compliance_status"/>
                <field name="collection_location_id"/>
            </list>
        </field>
    </record>

    
    <record id="view_hazardous_waste_record_form" model="ir.ui.view">
        <field name="name">agri.hazardous.waste.record.form</field>
        <field name="model">agri.hazardous.waste.record</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_transfer_waste" type="object" string="Transfer Waste" class="btn-primary" invisible="compliance_status != 'pending'"/>
                    <button name="action_mark_disposed" type="object" string="Mark Disposed" class="btn-success" invisible="compliance_status not in ('in_transit', 'pending')"/>
                    <button name="action_generate_compliance_report" type="object" string="Compliance Report" class="btn-info"/>
                    <field name="compliance_status" widget="statusbar" statusbar_visible="pending,in_transit,disposed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_hazardous_waste_record)d" type="action" class="oe_stat_button" icon="fa-trash">
                            <field string="Hazardous Records" name="name" widget="statinfo"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="waste_type"/>
                            <field name="description" colspan="2"/>
                        </group>
                        <group>
                            <field name="quantity"/>
                            <field name="unit_uom"/>
                            <field name="collection_date"/>
                            <field name="collection_location_id"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Collection Details">
                            <group>
                                <group string="Collection Information">
                                    <field name="collected_by"/>
                                    <field name="regulatory_reference"/>
                                </group>
                                <group string="Transfer Information">
                                    <field name="transfer_to_partner"/>
                                    <field name="transfer_date"/>
                                    <field name="transfer_manifest_number"/>
                                    <field name="transfer_weight"/>
                                </group>
                            </group>
                        </page>

                        <page string="Disposal Information">
                            <group>
                                <group>
                                    <field name="disposal_method"/>
                                    <field name="disposal_certificate" filename="disposal_certificate_name"/>
                                    <field name="disposal_certificate_name" invisible="1"/>
                                </group>
                            </group>
                        </page>

                        <page string="Compliance Audit Trail">
                            <field name="audit_trail" colspan="2" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    
    <record id="action_hazardous_waste_compliance_report" model="ir.actions.act_window">
        <field name="name">Hazardous Waste Compliance Report</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">agri.hazardous.waste.compliance.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>