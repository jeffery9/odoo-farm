<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- AI Vision Risk Assessment Tree View -->
    <record id="view_ai_vision_risk_assessment_tree" model="ir.ui.view">
        <field name="name">agri.ai.vision.risk.assessment.tree</field>
        <field name="model">agri.ai.vision.risk.assessment</field>
        <field name="arch" type="xml">
            <tree string="AI Vision Risk Assessment">
                <field name="name"/>
                <field name="risk_type"/>
                <field name="risk_level"/>
                <field name="risk_score"/>
                <field name="affected_area_percentage"/>
                <field name="potential_loss"/>
                <field name="confidence_score"/>
                <field name="analysis_date"/>
                <field name="status"/>
            </tree>
        </field>
    </record>

    <!-- AI Vision Risk Assessment Form View -->
    <record id="view_ai_vision_risk_assessment_form" model="ir.ui.view">
        <field name="name">agri.ai.vision.risk.assessment.form</field>
        <field name="model">agri.ai.vision.risk.assessment</field>
        <field name="arch" type="xml">
            <form string="AI Vision Risk Assessment">
                <header>
                    <button name="action_process_image" type="object" string="Process Image" class="oe_highlight"/>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="AI Vision Risk Assessment"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="risk_type"/>
                            <field name="risk_level"/>
                            <field name="risk_score"/>
                        </group>
                        <group>
                            <field name="affected_area_percentage"/>
                            <field name="potential_loss"/>
                            <field name="confidence_score"/>
                            <field name="analysis_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Image">
                            <group>
                                <field name="image" filename="image_filename"/>
                            </group>
                        </page>
                        <page string="Risk Analysis">
                            <group>
                                <field name="risk_description"/>
                                <field name="mitigation_recommendations"/>
                                <field name="risk_monitoring_plan"/>
                            </group>
                        </page>
                        <page string="Results &amp; Parameters">
                            <group>
                                <field name="input_parameters" widget="ace" options="{'mode': 'json'}"/>
                                <field name="output_data" widget="ace" options="{'mode': 'json'}"/>
                                <field name="analysis_result"/>
                            </group>
                        </page>
                        <page string="ISL Configuration">
                            <group>
                                <field name="industry_id"/>
                                <field name="uses_isl_data"/>
                                <field name="data_isolation_level"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- AI Vision Risk Assessment Action -->
    <record id="action_ai_vision_risk_assessment" model="ir.actions.act_window">
        <field name="name">Vision Risk Assessment</field>
        <field name="res_model">agri.ai.vision.risk.assessment</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add your first vision-based risk assessment!
            </p>
            <p>
                AI-powered risk assessment using computer vision. Upload images to assess
                various agricultural risks including crop health, weather damage, pest outbreaks,
                disease spread, quality defects, and yield loss.
            </p>
        </field>
    </record>
</odoo>