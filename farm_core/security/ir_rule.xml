<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- 4. Location / Land Plot Rules -->
        <record id="rule_agri_location_worker" model="ir.rule">
            <field name="name">Worker: See Own or Unassigned Plots</field>
            <field name="model_id" ref="model_farm_location"/>
            <!-- Can see the plot if they are the owner, OR if there is no specific owner (public coop land) -->
            <field name="domain_force">['|', ('owner_id', '=', user.partner_id.id), ('owner_id', '=', False)]</field>
            <field name="groups" eval="[(4, ref('farm_core.group_farm_worker'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <record id="rule_agri_location_manager" model="ir.rule">
            <field name="name">Manager: See All Plots</field>
            <field name="model_id" ref="model_farm_location"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('farm_core.group_farm_manager'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>
    
        <record id="rule_agri_location_owner_hierarchy" model="ir.rule">
            <field name="name">Farm Owner: See Own, Subordinate, or Unassigned Plots</field>
            <field name="model_id" ref="model_farm_location"/>
            <field name="domain_force">['|', '|', ('owner_id', '=', user.partner_id.id), ('owner_id.parent_id', '=', user.partner_id.id), ('owner_id', '=', False)]</field>
            <field name="groups" eval="[(4, ref('farm_core.group_farm_specialist'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>
    </data>
</odoo>
