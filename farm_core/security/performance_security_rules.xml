<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Security rules for performance and audit logs -->
    <record id="agri_performance_monitor_rule" model="ir.rule">
        <field name="name">Agricultural Performance Monitor Access</field>
        <field name="model_id" ref="model_agri_performance_monitor"/>
        <field name="domain_force">[
            '|',
            ('company_id', '=', user.company_id.id),
            ('company_id', '=', False)
        ]</field>
        <field name="groups" eval="[(4, ref('farm_core.group_farm_user'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>

    <record id="agri_audit_log_rule" model="ir.rule">
        <field name="name">Agricultural Audit Log Access</field>
        <field name="model_id" ref="model_agri_audit_log"/>
        <field name="domain_force">[
            '|',
            ('company_id', '=', user.company_id.id),
            ('company_id', '=', False)
        ]</field>
        <field name="groups" eval="[(4, ref('farm_core.group_farm_manager'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>

    <!-- Industry-specific access control for livestock -->
    <record id="farm_livestock_production_security_rule" model="ir.rule">
        <field name="name">Livestock Production Industry Security Rule</field>
        <field name="model_id" ref="farm_livestock.model_farm_livestock_production"/>
        <field name="domain_force">[
            '|',
            ('config_settings', 'ilike', '%livestock%'),
            ('industry_access_control', '!=', {})
        ]</field>
        <field name="groups" eval="[(4, ref('farm_core.group_farm_user'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="0"/>
    </record>

