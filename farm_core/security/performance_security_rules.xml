            ('industry_access_control', '!=', {})
        ]</field>
        <field name="groups" eval="[(4, ref('farm_core.group_farm_user'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="0"/>
    </record>

    <!-- Industry-specific access control for aquaculture -->
    <record id="farm_aquaculture_production_security_rule" model="ir.rule">
        <field name="name">Aquaculture Production Industry Security Rule</field>
        <field name="model_id" ref="farm_aquaculture.model_farm_aquaculture_production"/>
        <field name="domain_force">[
