<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Farm Location Tree View (Odoo 19 Standard) -->
    <record id="view_farm_location_tree" model="ir.ui.view">
        <field name="name">farm.location.list</field>
        <field name="model">farm.location</field>
        <field name="arch" type="xml">
            <list string="Farm Locations">
                <field name="name"/>
                <field name="location_type"/>
                <field name="spatial_grid_id"/>
                <field name="is_land_parcel"/>
                <field name="land_nature"/>
                <field name="land_area"/>
                <field name="impact_credits"/>
            </list>
        </field>
    </record>

    <!-- Farm Location Form View (Odoo 19 Standard) -->
    <record id="view_farm_location_form" model="ir.ui.view">
        <field name="name">farm.location.form</field>
        <field name="model">farm.location</field>
        <field name="arch" type="xml">
            <form string="Farm Location">
                <header>
                    <button name="action_view_quality_fingerprint" type="object" string="View Quality Fingerprint" class="oe_highlight"/>
                    <field name="clearing_status" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" string="Operational Name"/>
                        <h1><field name="name" placeholder="e.g. North Field Sector A"/></h1>
                        <group>
                            <field name="agri_location_id" readonly="1" groups="base.group_no_one"/>
                        </group>
                    </div>
                    <group>
                        <group string="Physical Identity (Agri Domain)">
                            <field name="location_type"/>
                            <field name="spatial_grid_id"/>
                            <field name="geo_point"/>
                        </group>
                        <group string="Operational Management (Farm)">
                            <field name="is_land_parcel"/>
                            <field name="active"/>
                            <field name="farm_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Agricultural Properties" name="agri_props" invisible="not is_land_parcel">
                            <group>
                                <group>
                                    <field name="land_nature"/>
                                    <field name="land_area"/>
                                    <field name="land_area_uom_id"/>
                                </group>
                                <group>
                                    <field name="calculated_area_ha"/>
                                    <button name="calculate_area" type="object" string="Update GIS Area" class="oe_link"/>
                                </group>
                            </group>
                        </page>
                        <page string="GIS &amp; Terroir" name="gis_terroir">
                            <group>
                                <group string="Coordinates">
                                    <field name="gps_lat"/>
                                    <field name="gps_lng"/>
                                    <field name="gis_map_url" widget="url"/>
                                </group>
                                <group string="Environment">
                                    <field name="soil_type"/>
                                    <field name="slope"/>
                                    <field name="aspect"/>
                                    <field name="water_source"/>
                                </group>
                            </group>
                            <field name="boundary_geojson" widget="ace" options="{'mode': 'json'}"/>
                        </page>
                        <page string="Soil Analyses" name="soil_analyses" invisible="not is_land_parcel">
                            <field name="soil_analysis_ids">
                                <list>
                                    <field name="analysis_date"/>
                                    <field name="ph_level"/>
                                    <field name="organic_matter"/>
                                    <field name="nitrogen_content" optional="show"/>
                                    <field name="state" widget="badge" decoration-success="state == 'done'" decoration-info="state == 'draft'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Value &amp; Evidence" name="value_evidence">
                            <group>
                                <group string="Sustainability">
                                    <field name="carbon_intensity"/>
                                    <field name="esg_score"/>
                                    <field name="impact_credits"/>
                                </group>
                                <group string="Audit Status">
                                    <field name="audit_status"/>
                                    <field name="audit_confidence"/>
                                </group>
                            </group>
                            <field name="quality_fingerprint" widget="ace" options="{'mode': 'json'}"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter>
                    <message/>
                    <activity/>
                </chatter>
            </form>
        </field>
    </record>

    <!-- Soil Analysis Registry View (Odoo 19) -->
    <record id="view_soil_analysis_tree" model="ir.ui.view">
        <field name="name">agri.soil.analysis.list</field>
        <field name="model">agri.soil.analysis</field>
        <field name="arch" type="xml">
            <list string="Soil Analyses" decoration-info="state == 'draft'" decoration-success="state == 'done'">
                <field name="name"/>
                <field name="location_id"/>
                <field name="analysis_date"/>
                <field name="ph_level"/>
                <field name="organic_matter"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_soil_analysis_form" model="ir.ui.view">
        <field name="name">agri.soil.analysis.form</field>
        <field name="model">agri.soil.analysis</field>
        <field name="arch" type="xml">
            <form string="Soil Analysis">
                <header>
                    <button name="action_validate" type="object" string="Validate" class="oe_highlight" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name"/></h1>
                        <group>
                            <field name="agri_analysis_id" readonly="1" groups="base.group_no_one"/>
                        </group>
                    </div>
                    <group>
                        <group string="Analysis Identity">
                            <field name="location_id"/>
                            <field name="analysis_date"/>
                            <field name="laboratory_id"/>
                        </group>
                        <group string="Physical Context">
                            <field name="spatial_grid_id"/>
                            <field name="audit_confidence" widget="progressbar"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Nutrients &amp; pH" name="nutrients">
                            <group>
                                <group string="Macro Nutrients">
                                    <field name="nitrogen_content"/>
                                    <field name="phosphorus_content"/>
                                    <field name="potassium_content"/>
                                </group>
                                <group string="Basic Indicators">
                                    <field name="ph_level"/>
                                    <field name="organic_matter"/>
                                </group>
                            </group>
                        </page>
                        <page string="Heavy Metals" name="heavy_metals">
                            <group>
                                <group string="Toxic Elements">
                                    <field name="lead_content"/>
                                    <field name="cadmium_content"/>
                                    <field name="mercury_content"/>
                                    <field name="arsenic_content"/>
                                </group>
                                <group string="Trace Elements">
                                    <field name="chromium_content"/>
                                    <field name="copper_content"/>
                                    <field name="zinc_content"/>
                                    <field name="nickel_content"/>
                                </group>
                            </group>
                        </page>
                        <page string="Advice &amp; Remediation" name="advice">
                            <group>
                                <field name="recommendation"/>
                                <field name="remediation_advice"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter>
                    <message/>
                    <activity/>
                </chatter>
            </form>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_farm_location_list" model="ir.actions.act_window">
        <field name="name">Farm Locations</field>
        <field name="res_model">farm.location</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_soil_analysis_list" model="ir.actions.act_window">
        <field name="name">Soil Analyses</field>
        <field name="res_model">agri.soil.analysis</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
