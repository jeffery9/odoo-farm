<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings_view_form_farm_core" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.farm.core</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="base_setup.res_config_settings_view_form" />
            <field name="arch" type="xml">
                <xpath expr="//form" position="inside">
                    <app data-string="Agri-OS Suite" string="Agri-OS Suite" name="farm_core">
                        <block title="Commercial Edition &amp; SKU Gating" name="farm_sku_gating_block">
                            <setting id="iot_telemetry_toggle" string="Base Farm IoT &amp; Telemetry" help="Show the Telemetry Center App icon on home screen.">
                                <field name="group_enable_iot_telemetry" />
                            </setting>
                            <setting id="a2a_netting_toggle" string="A2A Netting Clearing" help="Enable cooperative bilateral billing &amp; credit limit netting.">
                                <field name="group_enable_a2a_netting" />
                            </setting>
                            <setting id="biological_valuation_toggle" string="Biological SVL/AVL" help="Auto-post biological growth values to accounting entries.">
                                <field name="group_enable_biological_valuation" />
                            </setting>
                        </block>
                    </app>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
