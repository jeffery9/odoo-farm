<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>
<record id="view_farm_geofence_tree" model="ir.ui.view">
        <field name="name">agri.geospatial.geofence.tree</field>
        <field name="model">agri.geospatial.geofence</field>
        <field name="arch" type="xml">
            <list string="Geofences">
                <field name="name" />
                <field name="fence_type" />
                <field name="target_category" />
                <field name="alert_level" />
                <field name="active" />
                <field name="company_id" />
            </list>
        </field>
    </record>

    
    <record id="view_farm_geofence_form" model="ir.ui.view">
        <field name="name">agri.geospatial.geofence.form</field>
        <field name="model">agri.geospatial.geofence</field>
        <field name="arch" type="xml">
            <form string="Geofence">
                <header>
                    <field name="active" widget="boolean_toggle" />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="fence_type" />
                        </group>
                        <group>
                            <field name="target_category" />
                            <field name="alert_level" />
                        </group>
                    </group>
                    <group>
                        <field name="company_id" />
                    </group>
                    <field name="coordinates" />
                </sheet>
            </form>
        </field>
    </record>

    

    
    <record id="action_farm_geofence_list" model="ir.actions.act_window">
        <field name="name">Farm Geofences</field>
        <field name="res_model">agri.geospatial.geofence</field>
        <field name="view_mode">list,form</field>
    </record>
</data>
</odoo>