<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>
<record id="view_agri_biological_growth_curve_list" model="ir.ui.view">
        <field name="name">agri.biological.growth.curve.list</field>
        <field name="model">agri.biological.growth.curve</field>
        <field name="arch" type="xml">
            <list string="Biological Growth Curves" editable="bottom">
                <field name="product_id" />
                <field name="age_days" />
                <field name="target_weight" />
                <field name="daily_feed_rate" widget="percentage" />
            </list>
        </field>
    </record>

    
    <record id="action_agri_biological_growth_curve" model="ir.actions.act_window">
        <field name="name">Growth Curves</field>
        <field name="res_model">agri.biological.growth.curve</field>
        <field name="view_mode">list</field>
    </record>

    
    <menuitem id="menu_agri_growth_curve" name="Growth Curves" web_icon="farm_core,static/description/icon.png" action="action_agri_biological_growth_curve" sequence="30" />
</data>
</odoo>